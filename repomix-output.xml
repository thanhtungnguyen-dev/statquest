  assert.equal(
    result.resume?.remainingMinutes,
    mission.steps.slice(1).reduce((total, step) => total + step.minutes, 0),
  );
  assert.equal(result.recommendation, null);
  assert.equal(result.guardianMessage, "Step 2 is ready.");
});

