body::before,
body::after {
  position: fixed;
  z-index: 0;
  inset: 0;
  pointer-events: none;
  content: "";
}

body::before {
  inset: -18%;
  background:
    radial-gradient(circle at 82% 12%, rgba(88, 101, 242, 0.13), transparent 27%),
    radial-gradient(circle at 14% 32%, rgba(53, 167, 255, 0.12), transparent 30%),
