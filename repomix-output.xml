  padding: 18px;
  border: 1px dashed rgba(124, 255, 155, 0.4);
  border-radius: 15px;
  background: rgba(7, 18, 11, 0.45);
}

.evidence-box ul {
  display: grid;
  gap: 7px;
  margin: 10px 0 0;
  padding-left: 20px;
  color: var(--muted);
  font-size: 14px;
}

.evidence-quality-note {
  margin: 14px 0 0;
  padding-top: 14px;
  border-top: 1px solid rgba(124, 255, 155, 0.2);
  color: #c5d2e3;
  font-size: 13px;
  line-height: 1.6;
}

.field-hint {
  color: var(--muted);
  font-size: 12px;
  font-weight: 500;
}

.evidence-form {
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px solid var(--border);
}

.evidence-form .primary-button { width: fit-content; }

.completion-box {
  margin-top: 20px;
  padding: 20px;
  border: 1px solid rgba(124, 255, 155, 0.35);
  border-radius: 15px;
  background: rgba(124, 255, 155, 0.08);
}

.completion-box strong { color: var(--green); }

.completion-box p {
  margin: 10px 0;
  color: #ced8e6;
  line-height: 1.6;
}

.completion-box a {
  color: var(--blue);
  font-size: 14px;
  font-weight: 750;
}

.history-list {
  display: grid;
  gap: 10px;
}

.history-list article {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: center;
  padding: 18px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface-soft);
}

.history-list h3 {
  margin: 6px 0 5px;
  font-size: 17px;
}

.history-list p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.history-list article > strong {
  flex: 0 0 auto;
  color: var(--green);
}

.history-status {
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.history-status.completed { color: var(--green); }
.history-status.active { color: var(--blue); }
.history-status.missed { color: var(--danger); }
.history-status.abandoned { color: var(--orange); }

.review-grid {
  display: grid;
  grid-template-columns: 1.25fr 0.75fr;
  gap: 18px;
}

.review-form, .latest-review {
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: 20px;
  background: var(--surface-soft);
}

.review-form .primary-button { width: fit-content; }

.latest-review {
  align-self: start;
}

.latest-review > span:first-child {
  display: block;
  margin-bottom: 8px;
  color: var(--muted);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.latest-review > strong { display: block; }
.latest-review > p { color: var(--muted); }

.latest-review dl {
  display: grid;
  gap: 14px;
  margin: 22px 0;
}

.latest-review dl div {
  padding-top: 14px;
  border-top: 1px solid var(--border);
}

.latest-review dt {
  margin-bottom: 5px;
  color: var(--muted);
  font-size: 11px;
  text-transform: uppercase;
}

.latest-review dd {
  margin: 0;
  color: #d9e0ea;
  font-size: 14px;
  line-height: 1.5;
}

footer {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  padding: 18px 4px 0;
  color: var(--muted);
  font-size: 12px;
}

footer strong { color: var(--text); }

/* Cozy adventure onboarding */
.game-scene,
.enter-world-transition {
  position: relative;
  z-index: 2;
  min-height: 100svh;
  overflow: hidden;
  color: #18364a;
  background: #91d9f2;
}

.game-scene { overflow-y: auto; }

.game-world-backdrop {
  position: fixed;
  z-index: 0;
  inset: 0;
  overflow: hidden;
  background:
    linear-gradient(to bottom, #79ccf0 0%, #bdeaf8 47%, #e6f7d3 48%, #65bd71 75%, #319a5a 100%);
  pointer-events: none;
}

.game-scene-content {
  position: relative;
  z-index: 2;
  min-height: 100svh;
}

.storybook-sun {
  position: absolute;
  top: 6%;
  right: 10%;
  width: 104px;
  height: 104px;
  border-radius: 50%;
  background: #ffe78a;
  box-shadow: 0 0 0 18px rgba(255, 238, 157, 0.2), 0 0 70px #fff0a3;
  animation: sun-breathe 7s ease-in-out infinite alternate;
}

.storybook-sun span {
  position: absolute;
  inset: 18px;
  border-radius: inherit;
  background: #fff3aa;
}

.cloud {
  position: absolute;
  width: 170px;
  height: 52px;
  border-radius: 60px;
  background: rgba(255, 255, 255, 0.88);
  filter: drop-shadow(0 10px 9px rgba(45, 113, 147, 0.08));
  transform: translateX(calc(var(--scene-x) * -7px));
  animation: cloud-drift 24s linear infinite;
}

.cloud i {
  position: absolute;
  bottom: 18px;
  display: block;
  border-radius: 50%;
  background: inherit;
}

.cloud i:nth-child(1) { left: 28px; width: 62px; height: 62px; }
.cloud i:nth-child(2) { left: 72px; width: 82px; height: 82px; }
.cloud i:nth-child(3) { right: 8px; width: 51px; height: 51px; }
.cloud-one { top: 10%; left: -12%; animation-duration: 35s; }
.cloud-two { top: 23%; left: 31%; width: 130px; transform: scale(.72); animation-duration: 42s; animation-delay: -18s; }
.cloud-three { top: 6%; left: 66%; transform: scale(.55); animation-duration: 48s; animation-delay: -31s; }

.world-landscape {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform: translate3d(calc(var(--scene-x) * -5px), calc(var(--scene-y) * -2px), 0) scale(1.015);
  transform-origin: center bottom;
  transition: transform 180ms ease-out;
}

.far-hill { opacity: .88; }
.near-hill { filter: drop-shadow(0 -8px 0 rgba(255, 255, 255, 0.08)); }
.world-path { fill: #e9cc8e; stroke: #c49b5b; stroke-width: 7; }
.distant-trees rect { fill: #8c6845; }
.distant-trees circle { fill: #3d9b5d; stroke: #2b7e4c; stroke-width: 8; }
.study-cottage { filter: drop-shadow(0 18px 12px rgba(49, 81, 48, 0.22)); }
.cottage-wall { fill: #fff0c5; stroke: #855f42; stroke-width: 8; }
.cottage-roof { fill: #e97961; stroke: #944638; stroke-width: 8; stroke-linejoin: round; }
.roof-trim { fill: none; stroke: #ffb184; stroke-width: 12; stroke-linecap: round; }
.chimney { fill: #9b5a4d; stroke: #6e3e35; stroke-width: 7; }
.cottage-door { fill: #71a77c; stroke: #466d50; stroke-width: 8; }
.door-knob { fill: #ffe071; stroke: #875f25; stroke-width: 4; }
.cottage-window rect { fill: #8bd8f4; stroke: #79563e; stroke-width: 8; }
.cottage-window path { fill: none; stroke: #fff6da; stroke-width: 6; }
.cottage-vine { fill: none; stroke: #4c9b58; stroke-width: 10; stroke-linecap: round; }
.smoke-puffs { fill: rgba(255, 255, 255, 0.65); animation: smoke-rise 5s ease-in-out infinite; }
.foreground-rocks { fill: #8aa19a; stroke: #607a71; stroke-width: 7; }

.bird {
  position: absolute;
  z-index: 1;
  width: 45px;
  height: 20px;
  animation: bird-travel 18s linear infinite;
}

.bird span {
  position: absolute;
  top: 8px;
  width: 24px;
  height: 9px;
  border-top: 3px solid #35576c;
  border-radius: 50%;
}

.bird span:first-child { left: 0; transform: rotate(14deg); }
.bird span:last-child { right: 0; transform: rotate(-14deg); }
.flock-one { top: 16%; left: 48%; }
.flock-two { top: 28%; left: 12%; transform: scale(.7); animation-delay: -10s; }

.butterfly {
  position: absolute;
  z-index: 2;
  width: 28px;
  height: 22px;
  transform: translate3d(calc(var(--scene-x) * 18px), calc(var(--scene-y) * 10px), 0);
  animation: butterfly-float 5s ease-in-out infinite;
  transition: transform 220ms ease-out;
}

.butterfly i {
  position: absolute;
  top: 4px;
  width: 14px;
  height: 18px;
  border: 2px solid #8c4a7c;
  background: #f9a7dc;
}

.butterfly i:first-child { left: 1px; border-radius: 80% 30% 70% 40%; transform-origin: right; animation: wing-left .5s ease-in-out infinite alternate; }
.butterfly i:last-child { right: 1px; border-radius: 30% 80% 40% 70%; transform-origin: left; animation: wing-right .5s ease-in-out infinite alternate; }
.butterfly-one { left: 72%; bottom: 28%; }
.butterfly-two { left: 19%; bottom: 17%; animation-delay: -2.1s; transform: scale(.75); }
.butterfly-three { right: 5%; bottom: 39%; animation-delay: -3.7s; transform: scale(.62); }

.leaf {
  position: absolute;
  z-index: 1;
  width: 15px;
  height: 25px;
  border-radius: 90% 10% 90% 10%;
  background: #74b94f;
  animation: falling-leaf 10s linear infinite;
}
.leaf-one { top: 32%; left: 12%; }
.leaf-two { top: 24%; right: 22%; animation-delay: -4s; }
.leaf-three { top: 42%; right: 5%; animation-delay: -7s; }

.world-particle {
  position: absolute;
  z-index: 1;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #fff4a8;
  box-shadow: 0 0 9px #fff0a1;
  animation: particle-rise 6s ease-in-out infinite;
}

.particle-1 { left: 4%; bottom: 11%; }
.particle-2 { left: 13%; bottom: 24%; animation-delay: -1s; }
.particle-3 { left: 24%; bottom: 13%; animation-delay: -2.8s; }
.particle-4 { left: 41%; bottom: 21%; animation-delay: -4s; }
.particle-5 { left: 55%; bottom: 10%; animation-delay: -1.7s; }
.particle-6 { left: 64%; bottom: 25%; animation-delay: -3.3s; }
.particle-7 { left: 73%; bottom: 15%; animation-delay: -5s; }
.particle-8 { left: 82%; bottom: 24%; animation-delay: -2s; }
.particle-9 { left: 91%; bottom: 12%; animation-delay: -4.5s; }
.particle-10 { left: 97%; bottom: 30%; animation-delay: -.8s; }

.interactive-meadow {
  position: absolute;
  z-index: 3;
  inset: 0;
}

.grass-blade {
  position: absolute;
  width: 4px;
  border-radius: 90% 0;
  background: linear-gradient(90deg, #1c7843, #65c96a);
  transform-origin: center bottom;
  transition: transform 380ms cubic-bezier(.2, 1.5, .4, 1);
  animation: grass-idle 3.5s ease-in-out infinite alternate;
}

.meadow-flower {
  position: absolute;
  width: 5px;
  height: 34px;
  border-radius: 5px;
  background: #267b45;
  transform-origin: center bottom;
  transition: transform 420ms cubic-bezier(.2, 1.5, .4, 1);
  animation: flower-sway 4s ease-in-out infinite alternate;
}

.meadow-flower::before,
.meadow-flower::after,
.meadow-flower i {
  position: absolute;
  top: -9px;
  left: -6px;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #ffdc69;
  content: "";
}
.meadow-flower::after { transform: translateX(9px); }
.meadow-flower i { top: -14px; left: -1px; }
.meadow-flower.pink::before, .meadow-flower.pink::after, .meadow-flower.pink i { background: #ff92b4; }
.meadow-flower.blue::before, .meadow-flower.blue::after, .meadow-flower.blue i { background: #8ab6ff; }

.adventure-panel {
  position: relative;
  width: min(900px, calc(100% - 48px));
  margin: clamp(28px, 5vh, 60px) auto 80px max(24px, 5vw);
  padding: clamp(28px, 4vw, 44px);
  border: 2px solid rgba(83, 90, 64, 0.22);
  border-radius: 34px;
  color: #19364a;
  background:
    linear-gradient(145deg, rgba(255, 253, 244, 0.98), rgba(246, 242, 219, 0.97));
  box-shadow:
    0 28px 80px rgba(53, 76, 60, 0.3),
    inset 0 1px rgba(255, 255, 255, 0.9),
    0 0 0 7px rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(10px);
}

.adventure-panel::before {
  position: absolute;
  inset: 11px;
  border: 1px dashed rgba(99, 112, 77, 0.2);
  border-radius: 25px;
  pointer-events: none;
  content: "";
}

.adventure-intro {
  max-width: 780px;
  min-height: 245px;
  padding-right: 285px;
}

.adventure-kicker {
  display: inline-flex;
  margin-bottom: 13px;
  padding: 7px 11px;
  border: 1px solid #317e57;
  border-radius: 999px;
  color: #18563b;
  background: #dff6d5;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .14em;
}

.adventure-intro h1,
.transition-message h1 {
  max-width: 620px;
  margin-bottom: 16px;
  color: #173f58;
  font-size: clamp(37px, 5.5vw, 62px);
  line-height: .98;
  letter-spacing: -.052em;
  text-wrap: balance;
}

.adventure-intro p {
  max-width: 600px;
  margin-bottom: 16px;
  color: #405b69;
  font-size: 16px;
  line-height: 1.65;
}

.local-profile-note {
  color: #526b74;
  font-size: 12px;
  font-weight: 700;
}

.panel-guide {
  position: absolute;
  z-index: 3;
  top: 28px;
  right: 30px;
  width: 255px;
}

.hero-perch {
  position: relative;
  display: flex;
  height: 154px;
  justify-content: center;
  align-items: flex-end;
}

.hero-perch > span {
  position: absolute;
  z-index: -1;
  right: 0;
  bottom: 0;
  left: 0;
  height: 26px;
  border: 4px solid #865f3f;
  border-radius: 50%;
  background: #bc8b5e;
  box-shadow: 0 8px 0 #6f4b34;
}

.guide-speech {
  position: relative;
  min-height: 88px;
  margin-bottom: 4px;
  padding: 15px 16px;
  border: 2px solid #315f6f;
  border-radius: 20px 20px 8px 20px;
  color: #173747;
  background: #fffdf3;
  box-shadow: 0 9px 24px rgba(35, 75, 83, 0.18);
}

.guide-speech::after {
  position: absolute;
  right: 24px;
  bottom: -13px;
  width: 20px;
  height: 20px;
  border-right: 2px solid #315f6f;
  border-bottom: 2px solid #315f6f;
  background: inherit;
  transform: rotate(45deg);
  content: "";
}

.guide-speech.error { border-color: #a73f48; color: #6f1f29; background: #fff1ed; }
.guide-speech.error::after { border-color: #a73f48; }
.guide-speech.success { border-color: #27754e; color: #174f36; background: #e8f8df; }
.guide-speech.success::after { border-color: #27754e; }
.guide-speech p { margin: 4px 0 0; font-size: 13px; font-weight: 720; line-height: 1.45; }

.speech-target {
  display: block;
  color: inherit;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .09em;
  text-transform: uppercase;
}

.adventure-form {
  position: relative;
  z-index: 2;
  gap: 20px;
}

.character-creator {
  display: grid;
  min-width: 0;
  gap: 14px;
  margin: 0;
  padding: 20px;
  border: 1px solid #9eb09e;
  border-radius: 20px;
  background: rgba(235, 244, 220, 0.72);
}

.character-creator[aria-invalid="true"] {
  border-color: #ae414c;
  box-shadow: 0 0 0 3px rgba(174, 65, 76, 0.1);
}

.character-creator > legend,
.color-choices > legend,
.accessory-choices > legend {
  padding: 0 7px;
  color: #234b3b;
  font-size: 14px;
  font-weight: 900;
}

.character-creator > p {
  margin: -5px 0 0;
  color: #4a665b;
  font-size: 13px;
}

.hero-preset-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}

.hero-choice { position: relative; display: block; color: #24465b; }
.hero-choice > input,
.color-choices input,
.accessory-choices input {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
}

.hero-choice-card {
  display: grid;
  grid-template-columns: 68px minmax(0, 1fr);
  gap: 9px;
  min-height: 83px;
  align-items: center;
  padding: 8px 10px;
  border: 2px solid #afbfaf;
  border-radius: 15px;
  background: #fffdf4;
  cursor: pointer;
  transition: transform 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
}

.hero-choice-card:hover { transform: translateY(-2px); border-color: #5a8d6e; }
.hero-choice.selected .hero-choice-card { border-color: #277a50; background: #e3f5d9; box-shadow: 0 5px 14px rgba(39, 122, 80, 0.12); }
.hero-choice input:focus-visible + .hero-choice-card { outline: 3px solid #124e85; outline-offset: 3px; }
.hero-choice-card > span { display: grid; gap: 3px; }
.hero-choice-card strong { color: #203f4f; font-size: 14px; }
.hero-choice-card small { color: #51676e; font-size: 10px; line-height: 1.25; }

.hero-custom-row {
  display: grid;
  grid-template-columns: .72fr 1.28fr;
  gap: 14px;
}

.color-choices,
.accessory-choices {
  min-width: 0;
  margin: 0;
  padding: 12px;
  border: 1px solid #b5c4b0;
  border-radius: 14px;
}

.color-choices > div,
.accessory-choices > div { display: flex; flex-wrap: wrap; gap: 8px; }
.color-choices label { position: relative; display: block; }
.color-choices label > span:not(.sr-only) {
  display: block;
  width: 34px;
  height: 34px;
  border: 3px solid #fff;
  border-radius: 50%;
  box-shadow: 0 0 0 1px #819287;
  cursor: pointer;
}
.color-choices input:checked + span { box-shadow: 0 0 0 3px #194e3b; transform: scale(.88); }
.color-choices input:focus-visible + span { outline: 3px solid #124e85; outline-offset: 4px; }

.accessory-choices label { position: relative; display: block; }
.accessory-choices label > span {
  display: inline-flex;
  min-height: 34px;
  align-items: center;
  padding: 6px 10px;
  border: 1px solid #8ea495;
  border-radius: 999px;
  color: #29493d;
  background: #fffdf4;
  cursor: pointer;
  font-size: 11px;
  font-weight: 800;
}
.accessory-choices input:checked + span { border-color: #287650; color: #174b34; background: #dff3d6; box-shadow: inset 0 0 0 1px #287650; }
.accessory-choices input:focus-visible + span { outline: 3px solid #124e85; outline-offset: 3px; }

.adventure-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.adventure-fields label {
  color: #213f50;
  font-size: 13px;
  font-weight: 850;
}

.adventure-fields label > span:first-child { display: block; }
.quest-path-field { grid-column: 1 / -1; }

.adventure-panel input:not([type="radio"]),
.adventure-panel select {
  border: 2px solid #80969a;
  color: #163448;
  background: #fffefa;
  box-shadow: inset 0 2px 4px rgba(57, 74, 66, 0.05);
}

.adventure-panel input:not([type="radio"])::placeholder { color: #657b82; }
.adventure-panel input:not([type="radio"]):hover,
.adventure-panel select:hover { border-color: #54797b; }
.adventure-panel input:not([type="radio"]):focus,
.adventure-panel select:focus { border-color: #166a4a; box-shadow: 0 0 0 4px rgba(35, 132, 91, 0.16); }
.adventure-panel [aria-invalid="true"] { border-color: #a63844 !important; box-shadow: 0 0 0 4px rgba(166, 56, 68, 0.12) !important; }
.adventure-panel select option { color: #163448; background: #fffefa; }

.semantic-field-error {
  display: block;
  margin-top: -3px;
  color: #8c2631;
  font-size: 12px;
  font-weight: 760;
  line-height: 1.4;
}

.adventure-actions { display: flex; flex-wrap: wrap; gap: 10px; }
.enter-world-button,
.adventure-secondary-button,
.adventure-danger-button,
.skip-transition {
  min-height: 50px;
  border-radius: 14px;
  padding: 12px 18px;
  font-weight: 900;
}

.enter-world-button {
  display: inline-flex;
  flex: 1 1 260px;
  justify-content: space-between;
  align-items: center;
  border: 2px solid #145b3f;
  color: #102f24;
  background: linear-gradient(180deg, #8af2a1, #5bd47c);
  box-shadow: 0 6px 0 #24754d, 0 10px 24px rgba(33, 117, 74, 0.22);
  transition: transform 150ms ease, box-shadow 150ms ease;
}
.enter-world-button:hover { transform: translateY(-2px); box-shadow: 0 8px 0 #24754d, 0 13px 25px rgba(33, 117, 74, 0.25); }
.enter-world-button:active { transform: translateY(4px); box-shadow: 0 2px 0 #24754d; }

.adventure-secondary-button {
  border: 2px solid #567275;
  color: #244753;
  background: #fffdf4;
}
.adventure-secondary-button:hover { background: #e9f3e4; }
.adventure-danger-button { border: 2px solid #a8474f; color: #7e2630; background: #fff0ed; }
.adventure-danger-button:hover { background: #ffe0dc; }

.continue-adventure {
  position: relative;
  z-index: 2;
  display: grid;
  gap: 10px;
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid #b7c4b0;
}
.continue-adventure > span { color: #38574f; font-size: 12px; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
.continue-adventure > div { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
.continue-adventure button {
  display: grid;
  grid-template-columns: 48px 1fr auto;
  gap: 9px;
  align-items: center;
  min-height: 58px;
  padding: 7px 12px;
  border: 1px solid #779187;
  border-radius: 14px;
  color: #284851;
  background: #fffdf4;
