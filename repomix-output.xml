}

@keyframes entry-focus-ready {
  0% { box-shadow: 0 11px 26px color-mix(in srgb, var(--primary) 24%, transparent); }
  52% { box-shadow: 0 14px 30px color-mix(in srgb, var(--primary) 27%, transparent), 0 0 0 3px color-mix(in srgb, var(--green) 10%, transparent); }
  100% { box-shadow: 0 11px 26px color-mix(in srgb, var(--primary) 24%, transparent); }
}

@media (max-width: 960px) and (min-width: 761px) {
  .entry-profile-setup { grid-template-columns: minmax(0, 1fr); }
