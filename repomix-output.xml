.entry-about-dialog::before { position: absolute; z-index: -1; top: 0; right: 0; left: 0; height: 3px; background: linear-gradient(90deg, var(--primary), var(--green)); content: ""; }
.entry-about-heading { display: flex; justify-content: space-between; gap: 18px; align-items: start; }
.entry-about-lockup { display: flex; gap: 14px; align-items: center; }
.entry-about-lockup > div { display: grid; gap: 3px; }
.entry-about-lockup > div > span { color: var(--success-text); font-size: 11px; font-weight: 820; letter-spacing: .11em; }
.entry-about-heading h2 { max-width: 340px; margin: 0; font-size: 25px; font-weight: 750; line-height: 1.05; letter-spacing: -.04em; }
.entry-about-dialog > p { max-width: 46ch; margin: 20px 0 0; color: var(--muted); font-size: 14px; line-height: 1.55; }
.entry-about-flow { margin-top: 24px; }
.entry-about-capabilities { display: grid; grid-template-columns: 1fr 1fr; gap: 0 22px; margin: 24px 0 0; padding: 16px 0 0; border-top: 1px solid var(--border); color: var(--muted); font-size: 13px; list-style: none; }
.entry-about-capabilities li { position: relative; padding: 7px 0 7px 15px; }
.entry-about-capabilities li::before { position: absolute; top: 13px; left: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--green); content: ""; }
.entry-dialog-close { display: grid; width: 36px; height: 36px; flex: 0 0 auto; place-items: center; padding: 0; border: 1px solid var(--border); border-radius: 11px; color: var(--text); background: color-mix(in srgb, var(--surface-soft) 72%, transparent); font-size: 20px; line-height: 1; }
.entry-dialog-close:hover { border-color: color-mix(in srgb, var(--primary) 50%, var(--border)); background: var(--surface-bright); transform: translateY(-1px); }

html[data-theme="light"] .entry-profile-setup {
  background: linear-gradient(115deg, rgba(247, 248, 255, .66), rgba(241, 250, 247, .42));
}

html[data-theme="dark"] .entry-profile-setup {
  background: linear-gradient(115deg, rgba(16, 26, 43, .58), rgba(10, 28, 29, .34));
  box-shadow: none;
}

html[data-theme="dark"] .entry-return-grid {
  border-color: rgba(100, 121, 170, .42);
  background:
    radial-gradient(circle at 88% 0%, rgba(57, 214, 157, .075), transparent 32%),
    radial-gradient(circle at 0% 0%, rgba(104, 117, 245, .115), transparent 42%),
    rgba(8, 15, 27, .54);
  box-shadow: none;
}

@keyframes entry-surface-in {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes entry-continuity-in {
  from { opacity: 0; transform: translateY(7px); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes entry-welcome-ambient {
  from { transform: translate3d(-.45%, -.3%, 0) scale(1.004); }
