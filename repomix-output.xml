    linear-gradient(125deg, #f7f8fc 18%, #eef2fb 52%, #f3fbf8 100%);
  animation: ambient-shift 18s ease-in-out infinite alternate;
}

body::after {
  background-image:
    linear-gradient(rgba(88, 101, 242, 0.085) 1px, transparent 1px),
    linear-gradient(90deg, rgba(53, 167, 255, 0.08) 1px, transparent 1px);
  background-size: 42px 42px;
  mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.75), transparent 88%);
}

.pointer-grid-glow {
  position: fixed;
  z-index: 0;
  inset: 0;
  pointer-events: none;
  opacity: var(--pointer-grid-opacity);
  background-image:
    linear-gradient(rgba(53, 167, 255, 0.28) 1px, transparent 1px),
    linear-gradient(90deg, rgba(88, 101, 242, 0.3) 1px, transparent 1px);
  background-size: 42px 42px;
  -webkit-mask-image:
    radial-gradient(
      circle 230px at var(--pointer-x) var(--pointer-y),
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.82) 34%,
      rgba(0, 0, 0, 0.38) 68%,
      transparent 100%
    );
  mask-image:
    radial-gradient(
      circle 230px at var(--pointer-x) var(--pointer-y),
      rgba(0, 0, 0, 1) 0%,
      rgba(0, 0, 0, 0.82) 34%,
      rgba(0, 0, 0, 0.38) 68%,
      transparent 100%
    );
  transition: opacity 120ms ease-out;
}

[data-theme="dark"] body::before {
  background:
    radial-gradient(circle at 82% 12%, rgba(57, 214, 157, 0.15), transparent 27%),
    radial-gradient(circle at 14% 32%, rgba(104, 117, 245, 0.17), transparent 30%),
    radial-gradient(circle at 58% 84%, rgba(53, 167, 255, 0.09), transparent 26%),
    linear-gradient(125deg, #0b1220 18%, #101b2d 52%, #0b1916 100%);
}

[data-theme="dark"] body::after {
  background-image:
    linear-gradient(rgba(138, 170, 210, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(138, 170, 210, 0.06) 1px, transparent 1px);
}

[data-theme="dark"] .pointer-grid-glow {
  background-image:
    linear-gradient(rgba(168, 201, 255, 0.34) 1px, transparent 1px),
    linear-gradient(90deg, rgba(57, 214, 157, 0.32) 1px, transparent 1px);
}

@keyframes ambient-shift {
  from { transform: translate3d(-1.5%, -1%, 0) scale(1); }
  to { transform: translate3d(1.5%, 1%, 0) scale(1.035); }
}

button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
a { color: inherit; }
h1, h2, h3, h4, p { margin-top: 0; }
