  .entry-guardian span,
  .entry-guardian p { max-width: none; margin-inline: 0; text-align: left; }
  .entry-today-plan { grid-template-columns: 1fr; gap: 8px; padding: 14px 20px 16px; }
  .entry-today-plan h2 { margin-top: 0; }
  .entry-today-plan p { grid-template-columns: 112px minmax(0, 1fr); gap: 12px; }
  .entry-return-utility-row { align-items: stretch; flex-direction: column; gap: 8px; }
