const MUSTACHE_RE = /\{([^{}]+)\}/g;

export function shouldUseSvelteComponentInjection(filePath) {
  if (/^(0|false|no)$/i.test(process.env.IMPECCABLE_LIVE_SVELTE_COMPONENT || '')) return false;
