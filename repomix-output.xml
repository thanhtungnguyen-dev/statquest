.compact-history .history-list article { gap: 8px; padding: 9px; border-radius: 10px; background: #111c2b; }
.compact-history .history-list h3 { margin: 3px 0; font-size: 12px; }
.compact-history .history-list p { font-size: 10px; }
.compact-history .history-list article > strong { font-size: 10px; }

@media (max-width: 1100px) {
  .focus-shell { height: auto; min-height: 100svh; overflow: visible; }
  .focus-topbar { grid-template-columns: auto minmax(300px, 1fr) auto; gap: 10px; }
  .focus-dashboard {
    height: auto;
    grid-template-columns: minmax(230px, 36fr) minmax(0, 64fr);
  }
  .focus-progress-panel { grid-column: 1 / -1; }
  .focus-scroll-list,
  .mission-detail-scroll { max-height: 68svh; }
  .focus-review-scroll { max-height: none; overflow: visible; }
}

@media (max-width: 720px) {
  .focus-shell {
    width: min(100% - 16px, 1500px);
    padding-bottom: calc(92px + env(safe-area-inset-bottom));
  }
  .focus-topbar { grid-template-columns: 1fr auto; gap: 7px; margin-top: 6px; padding: 7px; border-radius: 15px; }
  .focus-top-actions { grid-column: 2; grid-row: 1; }
  .focus-top-stats { grid-row: 2; grid-column: 1 / -1; grid-template-columns: repeat(3, minmax(0, 1fr)); width: 100%; }
  .focus-progress-item { min-height: 38px; padding: 4px 7px; }
  .focus-account-menu > summary { max-width: 118px; min-height: 34px; }
  .focus-account-menu > summary span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .focus-top-actions .theme-toggle button { min-height: 28px; padding: 4px 7px; font-size: 9px; }
  .focus-dashboard { display: grid; grid-template-columns: 1fr; gap: 8px; padding-top: 8px; }
  .focus-progress-panel { grid-column: auto; }
  .focus-panel { min-height: auto; overflow: visible; border-radius: 16px; }
  .focus-scroll-list,
  .mission-detail-scroll,
  .compact-goal-form,
  .focus-review-scroll { max-height: none; overflow-y: visible; }
  .mission-selector { grid-template-columns: 1fr 1fr; }
  .mission-support-grid,
  .compact-evidence-form { grid-template-columns: 1fr; }
  .recommended-mission,
  .old-mission-actions { grid-template-columns: 1fr; }
  .recommended-mission button { width: 100%; }
  .course-detail-row { grid-template-columns: minmax(0, 1fr) auto; }
  .course-detail-row > label:nth-child(2) { grid-column: 1 / -1; }
  .mission-estimate { justify-items: start; }
  .mission-estimate small { text-align: left; }
  .compact-evidence-form .form-error,
  .compact-evidence-form button { grid-column: auto; }
  .floating-study-timer {
    bottom: max(8px, env(safe-area-inset-bottom));
    width: min(360px, calc(100vw - 18px));
    gap: 1px 10px;
    padding: 9px 12px;
    border-radius: 13px;
  }
  .floating-study-timer time { font-size: 21px; }
}

@media (max-width: 430px) {
  .focus-top-stats { gap: 4px; }
  .focus-progress-item { gap: 4px; }
  .focus-progress-item small,
  .focus-stat-kicker { font-size: 7px; }
  .focus-level-item small { display: none; }
  .compact-field-grid,
  .mission-selector { grid-template-columns: 1fr; }
  .compact-goal-actions { grid-template-columns: 1fr 1fr; }
  .compact-goal-actions .primary-button { grid-column: 1 / -1; }
}

@media (max-width: 900px) {
  .focus-room-layout {
    width: min(760px, calc(100% - 32px));
    min-height: auto;
    grid-template-columns: minmax(0, 1fr) 170px;
    grid-template-areas:
      "primary primary"
      "audio guardian";
    align-content: center;
    padding: 70px 0 34px;
  }
  .focus-room-audio,
  .focus-room-guardian { align-self: stretch; }
}

@media (max-width: 600px) {
  .focus-room-layout {
    width: min(100% - 18px, 520px);
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      "primary"
      "guardian"
      "audio";
    gap: 11px;
    padding: calc(66px + env(safe-area-inset-top)) 0 calc(24px + env(safe-area-inset-bottom));
  }
  .focus-room-minimize { top: max(12px, env(safe-area-inset-top)); right: 10px; }
  .focus-room-primary { padding: 24px 16px; border-radius: 21px; }
  .focus-room-countdown { margin-top: 20px; font-size: clamp(62px, 20vw, 82px); }
  .focus-room-actions { width: 100%; flex-direction: column; }
  .focus-room-actions button { width: 100%; }
  .focus-room-guardian { grid-template-columns: auto minmax(0, 1fr); align-items: center; justify-items: stretch; }
  .focus-room-guardian .quest-character { width: 78px; }
  .focus-guardian-dialogue { text-align: left; }
  .focus-room-audio { padding: 12px; }
}

@media (max-width: 820px) {
  .hero { grid-template-columns: 1fr; gap: 24px; padding-top: 38px; }
  .dashboard-grid { grid-template-columns: 1fr 1fr; }
  .field-grid, .three-columns, .goal-metrics, .review-grid {
    grid-template-columns: 1fr;
  }
  .topnav { display: none; }
  .goal-queue-list li { grid-template-columns: 44px minmax(0, 1fr); }
  .queue-actions { grid-column: 2; }
  .topbar { position: relative; }
  .adventure-panel {
    width: min(100% - 28px, 720px);
    margin: 22px auto 60px;
    padding: 28px;
  }
  .panel-guide {
    position: relative;
    top: auto;
    right: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 150px;
    width: 100%;
    align-items: end;
    margin-bottom: 22px;
  }
  .panel-guide .guide-speech { grid-column: 1; margin: 0 -8px 20px 0; }
  .panel-guide .hero-perch { grid-column: 2; grid-row: 1; height: 150px; }
  .adventure-intro { min-height: 0; padding-right: 0; }
  .adventure-intro h1 { font-size: clamp(38px, 8vw, 56px); }
  .return-panel { padding-right: 28px; }
  .return-hero { position: relative; top: auto; right: auto; display: grid; grid-template-columns: 1fr 150px; width: 100%; align-items: end; }
  .return-hero .guide-speech { margin-bottom: 24px; }
  .return-hero .quest-character { width: 135px; }
  .world-landscape { width: 120%; margin-left: -10%; }
  .study-cottage { transform: translate(1030px, 345px) scale(.8); }
}

@media (max-width: 560px) {
  .page-shell { width: min(100% - 22px, 1120px); }
  .status-pill { display: none; }
  .profile-menu .status-button { display: inline-flex; padding: 7px 9px; }
  .dashboard-grid { grid-template-columns: 1fr; }
  .goal-card-heading, .mission-heading, .section-heading-row {
    flex-direction: column;
  }
  .mission-reward { justify-items: start; }
  .button-row, footer {
    flex-direction: column;
  }
  .history-list article { align-items: flex-start; }
  .step-title-row { flex-direction: column; gap: 5px; }
  .queue-empty { align-items: stretch; flex-direction: column; }
  .goal-queue-list li { grid-template-columns: 36px minmax(0, 1fr); }
  .queue-position { width: 32px; height: 32px; }
  .queue-actions { grid-column: 1 / -1; }
  .reference-fieldset { padding: 16px; }
  .reference-file { grid-template-columns: 1fr; }
  .file-actions { width: 100%; }
  .compact-file-button { flex: 1; }
  .connected-sources li { align-items: flex-start; flex-direction: column; gap: 4px; }
  .adventure-panel { width: calc(100% - 18px); margin-top: 9px; padding: 20px 17px 26px; border-radius: 25px; }
  .adventure-panel::before { inset: 7px; border-radius: 19px; }
  .panel-guide { grid-template-columns: minmax(0, 1fr) 112px; gap: 4px; margin-bottom: 16px; }
  .panel-guide .guide-speech { margin-right: -10px; padding: 12px; border-radius: 16px 16px 6px 16px; }
  .panel-guide .hero-perch { height: 122px; }
  .panel-guide .quest-character { width: 116px; }
  .guide-speech p { font-size: 12px; }
  .adventure-intro h1 { font-size: clamp(34px, 10.5vw, 48px); }
  .adventure-intro p { font-size: 14px; }
  .character-creator { padding: 15px; }
  .hero-preset-grid { grid-template-columns: 1fr; }
  .hero-choice-card { grid-template-columns: 58px 1fr; min-height: 67px; }
  .hero-custom-row,
  .adventure-fields { grid-template-columns: 1fr; }
  .quest-path-field { grid-column: auto; }
  .continue-adventure > div { grid-template-columns: 1fr; }
  .adventure-actions { flex-direction: column; }
  .enter-world-button { flex-basis: auto; width: 100%; }
  .return-hero { grid-template-columns: 1fr 115px; }
  .return-hero .quest-character { width: 108px; }
  .return-panel .adventure-intro { margin-top: 18px; }
  .transition-message { margin-top: -30vh; padding: 22px 17px; }
  .transition-message h1 { font-size: 34px; }
  .transition-hero { left: 5%; bottom: 7%; }
  .portal-ring { right: 4%; bottom: 20%; transform: scale(.72); }
  .skip-transition { right: 10px; bottom: 10px; }
  .cloud-two { display: none; }
}

/* Pixel RPG character creation */
.adventurer-screen .game-scene-content {
  pointer-events: none;
}

.adventurer-screen .game-scene-content > * {
  pointer-events: auto;
}

.adventurer-screen .adventure-panel {
  width: min(900px, calc(100% - 40px));
  margin: clamp(22px, 4vh, 48px) auto 80px max(24px, 4vw);
  padding: clamp(24px, 4vw, 46px);
  border: 8px solid #74675d;
  border-radius: 8px;
  color: #32261d;
  background:
    linear-gradient(rgba(255, 249, 226, .92), rgba(232, 205, 159, .94)),
    #ead0a2;
  box-shadow:
    0 0 0 3px #342e2a,
    0 0 0 8px #a89a8e,
    0 22px 50px rgba(49, 36, 27, .35),
    inset 0 0 0 3px rgba(255, 255, 255, .42),
    inset 0 -18px 32px rgba(104, 65, 34, .11);
  backdrop-filter: none;
}

.adventurer-screen .adventure-panel::before {
  inset: 10px;
  border: 2px solid rgba(102, 74, 48, .42);
  border-radius: 2px;
  background:
    linear-gradient(135deg, #75675d 0 13px, transparent 13px) top left,
    linear-gradient(225deg, #75675d 0 13px, transparent 13px) top right,
    linear-gradient(45deg, #75675d 0 13px, transparent 13px) bottom left,
    linear-gradient(315deg, #75675d 0 13px, transparent 13px) bottom right;
  background-repeat: no-repeat;
  background-size: 24px 24px;
}

.adventurer-screen .adventure-intro {
  max-width: 780px;
  min-height: 0;
  padding: 0 0 24px;
}

.adventurer-screen .adventure-kicker,
.rpg-section-label {
  display: inline-flex;
  align-items: center;
  min-height: 34px;
  padding: 6px 15px;
  border: 3px solid #5c4939;
  border-radius: 3px 10px 3px 10px;
  color: #302219;
  background: linear-gradient(#e3be83, #bd8b56);
  box-shadow: 3px 3px 0 #40372f, inset 0 0 0 2px rgba(255, 239, 197, .42);
  font-size: 11px;
  font-weight: 950;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.adventurer-screen .adventure-intro h1,
.adventurer-screen .return-panel h1 {
  max-width: 740px;
  margin: 12px 0 15px;
  color: #3a291e;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(38px, 6vw, 68px);
  line-height: .98;
  letter-spacing: -.035em;
  text-shadow: 1px 2px 0 #f7e6bb;
}

.adventurer-screen .adventure-intro p {
  max-width: 680px;
  margin-bottom: 11px;
  color: #594638;
  font-weight: 650;
  line-height: 1.55;
}

.adventurer-screen .local-profile-note {
  color: #654f3e;
  font-weight: 800;
}

.adventurer-screen .adventure-form,
.rpg-character-setup {
  display: grid;
  gap: 20px;
}

.rpg-party-stage,
.rpg-fieldset {
  position: relative;
  min-width: 0;
  border: 4px solid #74675d;
  border-radius: 7px;
  color: #33271e;
  background:
    linear-gradient(145deg, rgba(255, 248, 220, .96), rgba(220, 187, 139, .96)),
    #ead0a2;
  box-shadow:
    0 0 0 2px #3b342f,
    inset 0 0 0 3px rgba(255, 255, 255, .34),
    inset 0 -12px 22px rgba(92, 58, 33, .11);
}

.rpg-party-stage {
  min-height: 290px;
  display: grid;
  grid-template-columns: minmax(180px, .8fr) minmax(310px, 1.2fr) 92px;
  align-items: end;
  gap: clamp(12px, 3vw, 34px);
  padding: 58px clamp(16px, 4vw, 38px) 20px;
  overflow: visible;
}

.rpg-party-stage .rpg-section-label {
  position: absolute;
  z-index: 4;
  top: -14px;
  left: 22px;
}

.rpg-stage-light {
  position: absolute;
  inset: 36% 8% -18%;
  border-radius: 50%;
  background: radial-gradient(ellipse, rgba(95, 151, 89, .28), transparent 66%);
  pointer-events: none;
}

.rpg-player-preview {
  position: relative;
  z-index: 2;
  display: grid;
  justify-items: center;
  align-self: end;
}

.rpg-player-preview > strong {
  margin-top: -6px;
  color: #302219;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 22px;
}

.rpg-player-preview > span:last-child {
  color: #76502e;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.player-character-stage {
  position: relative;
  display: grid;
  width: 190px;
  height: 210px;
  place-items: end center;
}

.player-character-motion {
  display: grid;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  place-items: end center;
  transform-origin: center bottom;
  animation: player-rpg-idle 3.8s ease-in-out infinite;
}

.player-character-stage > .player-character-motion {
  position: absolute;
  inset: 0;
}

.player-character-image {
  display: block;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  image-rendering: pixelated;
  filter: drop-shadow(0 10px 6px rgba(57, 39, 27, .26));
  user-select: none;
}

.companion-stage {
  position: relative;
  z-index: 3;
  min-width: 0;
  min-height: 230px;
  display: grid;
  grid-template-columns: minmax(150px, 1fr) 150px;
  align-items: end;
}

.companion-stage .guide-speech {
  z-index: 4;
  align-self: start;
  min-height: 108px;
  margin: 0 -14px 42px 0;
  border: 3px solid #56463a;
  border-radius: 7px 13px 5px 13px;
  color: #31261f;
  background: #fff8e7;
  box-shadow: 4px 5px 0 rgba(65, 47, 36, .28), inset 0 0 0 2px #dbc29a;
}

.companion-stage .guide-speech::after {
  right: -11px;
  bottom: 20px;
  border-color: #56463a;
  transform: rotate(-45deg);
}

.companion-stage .guide-speech.error {
  border-color: #943d3d;
  background: #fff0df;
}

.companion-stage .guide-speech.success {
  border-color: #33643f;
  background: #edf5d5;
}

.dialogue-dismiss {
  display: block;
  margin: 9px 0 0 auto;
  padding: 4px 9px;
  border: 2px solid #6d5948;
  border-radius: 3px;
  color: #3c2c21;
  background: #e5c690;
  font-size: 10px;
  font-weight: 900;
  text-transform: uppercase;
}

.companion-interaction {
  position: relative;
  z-index: 2;
  display: grid;
  min-width: 148px;
  min-height: 180px;
  place-items: end center;
  padding: 0;
  border: 0;
  background: transparent;
}

.companion-interaction:hover .quest-character {
  filter: brightness(1.04) drop-shadow(0 12px 7px rgba(54, 39, 28, .28));
}

.companion-interaction:focus-visible {
  border-radius: 8px;
  outline: 4px solid #155f91;
  outline-offset: 4px;
}

.quest-character {
  --companion-size: 170px;
  position: relative;
  display: block;
  width: var(--companion-size);
  height: var(--companion-size);
  overflow: visible;
  transform-origin: center bottom;
  filter: drop-shadow(0 10px 7px rgba(54, 39, 28, .24));
  animation: companion-rpg-idle 3.4s ease-in-out infinite;
}

.quest-character.small { --companion-size: 105px; }
.quest-character.mini { --companion-size: 58px; }

.companion-motion {
  position: absolute;
  z-index: 2;
  inset: 0;
  display: grid;
  min-width: 0;
  min-height: 0;
  overflow: hidden;
  place-items: center;
  transform: translate3d(var(--look-x), var(--look-y), 0);
  transition: transform 130ms ease-out;
}

.companion-image {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  min-width: 0;
  min-height: 0;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  image-rendering: pixelated;
  transform-origin: center 58%;
  animation: companion-rpg-blink 5.6s ease-in-out infinite;
  user-select: none;
}

.companion-shadow {
  position: absolute;
  z-index: 0;
  right: 18%;
  bottom: 3%;
  left: 18%;
  height: 10%;
  border-radius: 50%;
  background: rgba(62, 44, 31, .22);
}

.equipped-accessory {
  position: absolute;
  z-index: 5;
  right: -3px;
  bottom: 4px;
  width: 34%;
  height: 34%;
  display: grid;
  place-items: center;
  border: 2px solid #5f5045;
  border-radius: 6px;
  background: #f7e5bd;
  box-shadow: 2px 3px 0 rgba(55, 42, 33, .28);
}

.equipped-accessory img {
  width: 92%;
  height: 92%;
  object-fit: contain;
  image-rendering: pixelated;
}

.companion-celebration {
  position: absolute;
  z-index: 6;
  inset: -6%;
  opacity: 0;
  pointer-events: none;
}

.companion-celebration i {
  position: absolute;
  color: #b47721;
  font-style: normal;
}

.companion-celebration i:nth-child(1) { top: 10%; left: 3%; }
.companion-celebration i:nth-child(2) { top: 1%; right: 7%; }
.companion-celebration i:nth-child(3) { top: 42%; right: -2%; }
.quest-character.concerned { animation: companion-rpg-shake .38s ease; }
.quest-character.happy { animation: companion-rpg-happy .62s ease; }
.quest-character.celebrating { animation: companion-rpg-celebrate .62s ease; }
.quest-character.celebrating .companion-celebration { opacity: 1; }

.equipped-item-slot {
  position: relative;
  z-index: 3;
  display: grid;
  align-self: end;
  justify-items: center;
  gap: 5px;
  min-height: 96px;
  padding: 8px;
  border: 3px solid #65584e;
  border-radius: 5px;
  background: #e0c398;
  box-shadow: inset 0 0 0 2px #f5e5c3, 3px 4px 0 #4b4139;
}

.equipped-item-slot span {
  color: #544235;
  font-size: 9px;
  font-weight: 950;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.equipped-item-slot img {
  width: 62px;
  height: 62px;
  object-fit: contain;
  image-rendering: pixelated;
}

.rpg-fieldset {
  margin: 0;
  padding: 22px;
}

.rpg-fieldset[aria-invalid="true"] {
  border-color: #963c40;
  box-shadow: 0 0 0 2px #4f2e2e, inset 0 0 0 3px #ffdfc3;
}

.rpg-fieldset > legend {
  max-width: calc(100% - 18px);
  padding: 7px 15px;
  border: 3px solid #5c4939;
  border-radius: 3px 10px 3px 10px;
  color: #302219;
  background: linear-gradient(#e3be83, #bd8b56);
  box-shadow: 3px 3px 0 #40372f, inset 0 0 0 2px rgba(255, 239, 197, .42);
  font-size: 12px;
  font-weight: 950;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.rpg-fieldset > p {
  margin: 0 0 14px;
  color: #614d3d;
  font-size: 13px;
  font-weight: 700;
}

.player-class-grid,
.companion-selector-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.player-class-card,
.companion-card {
  position: relative;
  min-width: 0;
  border: 3px solid #78695e;
  border-radius: 6px;
  color: #4e3b2f;
  background: linear-gradient(145deg, #fff8e8, #e6cda4);
  box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .4), 0 4px 0 #51463e;
  cursor: pointer;
  transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
}

.player-class-card {
  display: grid;
  grid-template-rows: 135px auto;
  min-height: 270px;
  padding: 12px;
  text-align: center;
}

.player-class-card:hover,
.companion-card:hover {
  border-color: #506744;
  transform: translateY(-3px);
  box-shadow: inset 0 0 0 2px rgba(255, 255, 255, .48), 0 7px 0 #4f5b45;
}

.player-class-card.selected,
.companion-card.selected {
  border-color: #365e3d;
  background: linear-gradient(145deg, #eef2cf, #abd19c);
  box-shadow: inset 0 0 0 2px #f7ffe5, 0 5px 0 #2d4e35;
  animation: rpg-card-selected .34s ease;
}

.player-class-card:has(input:focus-visible),
.companion-card:has(input:focus-visible),
.accessory-grid label:has(input:focus-visible),
.color-choices label:has(input:focus-visible) {
  outline: 4px solid #155f91;
  outline-offset: 4px;
}

.rpg-radio {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
}

.player-class-art {
  display: grid;
  min-height: 0;
  place-items: center;
}

.player-class-art .player-character-motion {
  width: 112px;
  height: 128px;
}

.player-class-card:hover .player-character-motion {
  transform: translateY(-4px) scale(1.02);
}

.player-class-card:active .player-character-motion {
  transform: translateY(2px) scale(.97);
}

.player-class-copy {
  display: grid;
  align-content: start;
  gap: 4px;
}

.player-class-copy strong,
.companion-card strong {
  color: #2e231c;
  font-family: Georgia, "Times New Roman", serif;
  font-size: 19px;
}

.player-class-copy small {
  color: #875a2b;
  font-size: 10px;
  font-weight: 950;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.player-class-copy > span:last-child {
  color: #604c3d;
  font-size: 11px;
  font-weight: 650;
  line-height: 1.35;
}

.rpg-selected-mark {
  position: absolute;
  z-index: 4;
  top: 8px;
  right: 8px;
  width: 25px;
  height: 25px;
  display: none;
  place-items: center;
  border: 2px solid #2d5636;
  border-radius: 50%;
  color: #183d24;
  background: #f1ffd9;
  font-weight: 950;
}

.selected > .rpg-selected-mark { display: grid; }

.companion-card {
  display: grid;
  grid-template-columns: 88px minmax(0, 1fr);
  align-items: center;
  gap: 10px;
  min-height: 118px;
  padding: 10px;
}

.companion-card-art {
  width: 88px;
  height: 94px;
  display: grid;
  place-items: center;
  overflow: hidden;
  border: 2px solid #7b634f;
  border-radius: 5px;
  background: #e7cfa7;
}

.companion-card-art img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  image-rendering: pixelated;
}

.companion-card > span:nth-of-type(2) { display: grid; gap: 4px; }
.companion-card small { color: #5b493d; font-size: 11px; line-height: 1.3; }

.rpg-customization-row {
  display: grid;
  grid-template-columns: .72fr 1.28fr;
  gap: 14px;
  margin-top: 16px;
}

.rpg-customization-row fieldset {
  min-width: 0;
  margin: 0;
  padding: 13px;
  border: 3px solid #806f61;
  border-radius: 5px;
  background: rgba(248, 230, 193, .7);
}

.rpg-customization-row legend {
  padding: 0 7px;
  color: #403127;
  font-size: 11px;
  font-weight: 950;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.color-choices > div,
.accessory-grid > div {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.color-choices label,
.accessory-grid label {
  position: relative;
  cursor: pointer;
}

.color-choices label {
  display: grid;
  grid-template-columns: 30px minmax(0, 1fr);
  align-items: center;
  gap: 6px;
  min-width: 112px;
  padding: 5px;
  border: 2px solid transparent;
  color: #4d3d31;
  font-size: 10px;
  font-weight: 800;
}

.color-choices label:has(input:checked) {
  border-color: #4a5e40;
  border-radius: 4px;
  background: #edf1cf;
}

.color-swatch {
  width: 28px;
  height: 28px;
  border: 3px solid #fff5dc;
  border-radius: 50%;
  box-shadow: 0 0 0 2px #5f5147;
}

.accessory-grid label {
  flex: 1 1 110px;
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr);
  align-items: center;
  gap: 7px;
  min-height: 58px;
  padding: 6px;
  border: 2px solid #7b6a5d;
  border-radius: 5px;
  color: #4a392e;
  background: #fff5df;
  font-size: 10px;
  font-weight: 850;
  transition: transform 150ms ease, background 150ms ease;
}

.accessory-grid label:hover { transform: translateY(-2px); }
.accessory-grid label.selected { border-color: #31583a; background: #dbe8bd; }
.accessory-grid img { width: 42px; height: 42px; object-fit: contain; image-rendering: pixelated; }

.adventurer-details { margin-top: 0; }
.adventurer-screen .adventure-fields { gap: 16px; }
.adventurer-screen .adventure-fields label { display: grid; gap: 7px; color: #3f3026; }
.adventurer-screen .adventure-fields label > span:first-child { font-size: 12px; font-weight: 950; text-transform: uppercase; letter-spacing: .04em; }

.adventurer-screen .adventure-panel input:not([type="radio"]),
.adventurer-screen .adventure-panel select {
  min-height: 52px;
  border: 4px solid #6b5849;
  border-radius: 4px;
  color: #2f261f;
  background: #fffaf0;
  box-shadow: inset 0 0 0 2px #ddc6a0, 2px 3px 0 rgba(67, 50, 38, .24);
}

.adventurer-screen .adventure-panel input:not([type="radio"])::placeholder { color: #6e6259; }
.adventurer-screen .adventure-panel input:not([type="radio"]):hover,
.adventurer-screen .adventure-panel select:hover { border-color: #4d6546; }
.adventurer-screen .adventure-panel input:not([type="radio"]):focus,
.adventurer-screen .adventure-panel select:focus { border-color: #28613b; box-shadow: inset 0 0 0 2px #e0d1ae, 0 0 0 4px rgba(35, 99, 61, .18); }
.adventurer-screen .adventure-panel select option { color: #2f261f; background: #fffaf0; }

.adventurer-screen .semantic-field-error { color: #862f35; font-weight: 850; }

.adventurer-screen .enter-world-button,
.adventurer-screen .adventure-secondary-button,
.adventurer-screen .adventure-danger-button {
  border-radius: 4px;
}

.adventurer-screen .enter-world-button {
  border: 4px solid #55412f;
  color: #2e2118;
  background: linear-gradient(#d0a86d, #a97646);
  box-shadow: inset 0 0 0 2px #efcf97, 0 6px 0 #4b392b;
}

.adventurer-screen .enter-world-button:hover {
  background: linear-gradient(#dfba7e, #b9844c);
  box-shadow: inset 0 0 0 2px #f8dda9, 0 8px 0 #4b392b;
}

.adventurer-screen .enter-world-button:active { box-shadow: inset 0 0 0 2px #efcf97, 0 2px 0 #4b392b; }
.adventurer-screen .adventure-secondary-button { border: 3px solid #665548; color: #392c23; background: #f7e6c3; }
.adventurer-screen .adventure-danger-button { border: 3px solid #813e3e; color: #6d292d; background: #f9ddc8; }

.adventurer-screen .continue-adventure {
  border-top: 3px solid #8a6b4c;
}

.adventurer-screen .continue-adventure > span { color: #4e392b; }
.adventurer-screen .continue-adventure button {
  grid-template-columns: 92px 1fr auto;
  min-height: 78px;
  border: 3px solid #786353;
  border-radius: 5px;
  color: #3b2d24;
  background: #f4dfb9;
  box-shadow: inset 0 0 0 2px #fff0cf, 0 4px 0 #50443b;
}

.saved-party-avatar {
  position: relative;
  display: flex;
  width: 88px;
  height: 62px;
  align-items: end;
  justify-content: center;
}

.saved-party-avatar .player-character-stage { width: 52px; height: 60px; }
.saved-party-avatar .quest-character { margin-left: -9px; }

.return-panel {
  width: min(820px, calc(100% - 40px));
  min-height: 510px;
  padding-right: 300px;
}

.return-party {
  position: absolute;
  z-index: 2;
  top: 122px;
  right: 30px;
  display: flex;
  width: 255px;
  min-height: 230px;
  align-items: end;
  justify-content: center;
}

.return-party .player-character-stage { width: 155px; height: 195px; }
.return-party .quest-character { margin-left: -35px; }
.return-hero { position: absolute; z-index: 4; top: 28px; right: 28px; width: 260px; }
.return-hero .guide-speech { border: 3px solid #56463a; border-radius: 7px; color: #31261f; background: #fff8e7; }

.game-world-backdrop[data-time-of-day="night"] {
  background: linear-gradient(to bottom, #172b4a 0%, #344a6d 47%, #324d48 48%, #245443 75%, #152f2a 100%);
}

.game-world-backdrop[data-time-of-day="night"] .storybook-sun {
  background: #dce9ff;
  box-shadow: 0 0 0 18px rgba(196, 218, 255, .13), 0 0 70px rgba(211, 228, 255, .65);
}

.game-world-backdrop[data-time-of-day="night"] .storybook-sun span { background: #edf4ff; }
.game-world-backdrop[data-time-of-day="night"] .cloud { opacity: .42; }
.game-world-backdrop[data-time-of-day="night"] .far-hill,
.game-world-backdrop[data-time-of-day="night"] .near-hill { filter: brightness(.58) saturate(.76); }
.game-world-backdrop[data-time-of-day="night"] .cottage-window rect { fill: #ffd777; filter: drop-shadow(0 0 11px #ffd36b); }

.house-door-control-inner,
.house-door-hitbox {
  width: 100%;
  height: 100%;
}

.house-door-control { overflow: visible; pointer-events: auto; }
.house-door-control-inner { display: block; }
.house-door-hitbox {
  display: block;
  padding: 0;
  border: 5px solid transparent;
  border-radius: 46%;
  background: transparent;
  cursor: pointer;
  pointer-events: auto;
  transition: background 150ms ease, border-color 150ms ease, transform 150ms ease;
}

.house-door-hitbox:hover {
  border-color: rgba(255, 230, 137, .66);
  background: rgba(255, 232, 144, .18);
  transform: translateY(-2px);
}

.house-door-hitbox:focus-visible {
  border-color: #fff0a8;
  outline: 7px solid #244f78;
  outline-offset: 2px;
}

.study-cottage.day.door-reacted .cottage-door { animation: locked-door .36s ease; transform-origin: center; }
.study-cottage.night.door-reacted .cottage-door { animation: welcoming-door .48s ease; transform-origin: left center; }

@keyframes player-rpg-idle { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
@keyframes companion-rpg-idle { 0%, 100% { transform: translateY(0) rotate(-.4deg); } 50% { transform: translateY(-3px) rotate(.4deg); } }
@keyframes companion-rpg-blink { 0%, 45%, 48%, 100% { transform: scaleY(1); filter: none; } 46.5% { transform: scaleY(.97); filter: brightness(.9); } }
@keyframes companion-rpg-shake { 0%, 100% { transform: translateX(0); } 30% { transform: translateX(-3px) rotate(-1deg); } 65% { transform: translateX(3px) rotate(1deg); } }
@keyframes companion-rpg-happy { 0%, 100% { transform: translateY(0); } 45% { transform: translateY(-8px); } }
@keyframes companion-rpg-celebrate { 0%, 100% { transform: translateY(0) scale(1); } 45% { transform: translateY(-12px) scale(1.035) rotate(2deg); } }
@keyframes rpg-card-selected { 0% { transform: scale(.97); } 60% { transform: scale(1.02); } 100% { transform: scale(1); } }
@keyframes locked-door { 0%, 100% { transform: translateX(0); } 30% { transform: translateX(-3px); } 65% { transform: translateX(3px); } }
@keyframes welcoming-door { 0%, 100% { transform: perspective(180px) rotateY(0); } 55% { transform: perspective(180px) rotateY(-10deg); filter: brightness(1.14); } }

@media (max-width: 860px) {
  .adventurer-screen .adventure-panel { width: min(100% - 24px, 760px); margin-top: 18px; }
  .rpg-party-stage { grid-template-columns: minmax(145px, .75fr) minmax(270px, 1.25fr); }
  .equipped-item-slot { position: absolute; right: 12px; bottom: 12px; width: 74px; min-height: 80px; }
  .equipped-item-slot img { width: 48px; height: 48px; }
  .player-class-grid { grid-template-columns: 1fr; }
  .player-class-card { grid-template-columns: 130px minmax(0, 1fr); grid-template-rows: auto; min-height: 150px; text-align: left; }
  .player-class-art .player-character-motion { width: 118px; height: 128px; }
  .player-class-copy { align-content: center; }
  .companion-selector-grid { grid-template-columns: 1fr; }
  .companion-card { min-height: 104px; }
  .rpg-customization-row { grid-template-columns: 1fr; }
  .return-panel { padding-right: 28px; padding-bottom: 260px; }
  .return-party { top: auto; right: calc(50% - 128px); bottom: 18px; }
  .return-hero { position: relative; top: auto; right: auto; width: 100%; margin-bottom: 20px; }
}

@media (max-width: 580px) {
  .adventurer-screen .adventure-panel { width: calc(100% - 14px); margin-top: 7px; padding: 22px 15px 28px; border-width: 6px; }
  .adventurer-screen .adventure-panel::before { inset: 6px; }
  .adventurer-screen .adventure-intro h1 { font-size: clamp(35px, 11vw, 48px); }
  .rpg-party-stage { min-height: 420px; grid-template-columns: 1fr 1fr; gap: 2px; padding: 58px 8px 92px; }
  .rpg-player-preview .player-character-stage { width: 140px; height: 170px; }
  .rpg-player-preview > strong { font-size: 18px; }
  .companion-stage { min-height: 240px; grid-template-columns: 1fr; align-items: end; }
  .companion-stage .guide-speech { position: absolute; top: -48px; right: -2px; left: -72px; margin: 0; }
  .companion-stage .guide-speech::after { right: 28px; bottom: -12px; transform: rotate(45deg); }
  .companion-interaction { justify-self: end; min-width: 126px; min-height: 158px; }
  .companion-interaction .quest-character { --companion-size: 132px; }
  .equipped-item-slot { right: 50%; bottom: 8px; width: 68px; transform: translateX(50%); }
  .rpg-fieldset { padding: 17px 11px; }
  .player-class-card { grid-template-columns: 100px minmax(0, 1fr); min-height: 132px; padding: 8px; }
  .player-class-art .player-character-motion { width: 92px; height: 108px; }
  .player-class-copy strong { font-size: 17px; }
  .companion-card { grid-template-columns: 74px minmax(0, 1fr); }
  .companion-card-art { width: 72px; height: 80px; }
  .adventurer-screen .adventure-fields { grid-template-columns: 1fr; }
  .adventurer-screen .quest-path-field { grid-column: auto; }
  .adventurer-screen .continue-adventure button { grid-template-columns: 78px minmax(0, 1fr) auto; }
  .saved-party-avatar { width: 74px; }
}

@media (prefers-reduced-motion: reduce) {
  .player-character-motion,
  .quest-character,
  .companion-image,
  .study-cottage .cottage-door {
    animation: none !important;
  }

  .companion-motion {
    transform: none !important;
  }

  .player-class-card:hover,
  .companion-card:hover,
  .accessory-grid label:hover {
    transform: none;
  }
}

/* Final Focus appearance pass. These selectors intentionally exclude Adventure. */
.page-shell {
  --background: #0b1220;
  --surface: rgba(18, 29, 48, 0.96);
  --surface-soft: rgba(27, 42, 66, 0.94);
  --surface-bright: #263652;
  --input-surface: #09121f;
  --empty-surface: rgba(10, 17, 28, 0.88);
  --border: #425571;
  --text: #f4f7fc;
  --muted: #b8c4d6;
  --subtle: #aebbd0;
  --primary: #6875f5;
  --primary-hover: #7d88ff;
  --green: #39d69d;
  --success-text: #39d69d;
  --green-dark: #123126;
  --orange: #f7b84b;
  --reward-text: #f7b84b;
  --streak: #ff914d;
  --streak-text: #ff914d;
  --info: #58b7ff;
  --danger: #ff9da8;
  --blue: #a8c9ff;
  color: var(--text);
}

.page-shell::before {
  position: fixed;
  z-index: -1;
  inset: 0;
  content: "";
  background:
    linear-gradient(rgba(138, 170, 210, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(138, 170, 210, 0.045) 1px, transparent 1px),
    radial-gradient(circle at 15% 8%, rgba(57, 214, 157, 0.12), transparent 34%),
    radial-gradient(circle at 88% 12%, rgba(104, 117, 245, 0.15), transparent 36%),
    #0b1220;
  background-size: 42px 42px, 42px 42px, auto, auto, auto;
}

.onboarding-card,
.focus-panel {
  color: var(--text);
  background: var(--surface);
  backdrop-filter: blur(8px);
}

.focus-topbar {
  background:
    radial-gradient(circle at 8% 0%, rgba(102, 116, 238, .1), transparent 34%),
    radial-gradient(circle at 92% 100%, rgba(48, 190, 147, .07), transparent 33%),
    linear-gradient(115deg, rgba(11, 18, 32, .84), rgba(15, 27, 46, .77));
}

.focus-shell .status-pill,
.focus-shell .status-button {
  color: var(--text);
  background: var(--surface-soft);
}

.compact-goal-item,
.mission-selector button,
.compact-progress-grid div,
.compact-review-form,
.compact-latest-review,
.compact-history,
.review-form,
.latest-review,
.goal-metrics div,
.dashboard-grid article,
.reference-file {
  background: var(--surface-soft);
}

.onboarding-shell input,
.onboarding-shell select,
.onboarding-shell textarea,
.focus-shell input,
.focus-shell select,
.focus-shell textarea {
  color: var(--text);
  background: var(--input-surface);
}

.onboarding-shell select option,
.focus-shell select option { color: var(--text); background: var(--background); }

.empty-state,
.focus-empty { background: var(--empty-surface); }

.compact-mission-card {
  background: color-mix(in srgb, var(--surface-soft) 92%, var(--green-dark));
}

.compact-mission-card .mission-objective,
.compact-mission-card .completion-box p,
.latest-review dd { color: var(--muted); }

.focus-shell label,
.onboarding-shell label { color: var(--text); }

.focus-shell .primary-button,
.onboarding-shell .primary-button,
.focus-shell .brand-mark,
.onboarding-shell .brand-mark,
.focus-shell .upload-icon {
  color: #ffffff;
  background: var(--primary);
}

.focus-shell .primary-button:hover,
.onboarding-shell .primary-button:hover { background: var(--primary-hover); filter: none; }

.focus-shell :focus-visible,
.onboarding-shell :focus-visible { outline-color: var(--primary); }

.focus-shell .eyebrow,
.onboarding-shell .eyebrow { color: var(--primary-hover); }

.mission-reward strong,
.history-list article > strong { color: var(--reward-text); }
.history-status.completed,
.completion-box strong { color: var(--success-text); }
.focus-xp-item strong { color: var(--reward-text); }
.focus-streak-item strong { color: var(--streak-text); }

.today-reward-status {
  border-color: color-mix(in srgb, var(--green) 55%, var(--border));
  background: color-mix(in srgb, var(--green-dark) 82%, transparent);
}

.today-reward-status strong { color: var(--success-text); }

.mission-selector button.selected,
.mood-selector label.selected span {
  border-color: var(--primary);
  background: color-mix(in srgb, var(--primary) 14%, var(--surface-soft));
}

.minimal-screen-header {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: center;
  margin-bottom: 38px;
}

.onboarding-card .minimal-screen-header .brand-mark { margin-bottom: 0; }

.theme-toggle {
  display: inline-grid;
  flex: 0 0 auto;
  grid-template-columns: 1fr 1fr;
  gap: 3px;
  padding: 3px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: var(--surface-soft);
}

.theme-toggle button {
  min-height: 32px;
  padding: 5px 10px;
  border: 0;
  border-radius: 999px;
  color: var(--muted);
  background: transparent;
  font-size: 11px;
  font-weight: 800;
}

.theme-toggle button[aria-pressed="true"] {
  color: #ffffff;
  background: var(--primary);
}

.mission-selector button { position: relative; }
.mission-selector button time {
  color: var(--reward-text);
  font-size: 13px;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
}

.mission-countdown {
  display: grid;
  min-width: 112px;
  gap: 1px;
  justify-items: end;
  margin-top: 5px;
  padding-top: 6px;
  border-top: 1px solid var(--border);
}

.mission-countdown time {
  color: var(--reward-text);
  font-size: 20px;
  font-variant-numeric: tabular-nums;
  font-weight: 900;
}

.mission-countdown small { color: var(--muted); font-size: 10px; font-weight: 700; }

.onboarding-shell,
.focus-shell {
  caret-color: transparent;
  cursor: default;
}

.onboarding-shell input,
.onboarding-shell textarea,
.onboarding-shell [contenteditable="true"],
.focus-shell input,
.focus-shell textarea,
.focus-shell [contenteditable="true"] {
  caret-color: auto;
  cursor: text;
}

.onboarding-shell button,
.onboarding-shell a,
.onboarding-shell summary,
.focus-shell button,
.focus-shell a,
.focus-shell summary,
.focus-shell select { cursor: pointer; }

::view-transition-old(root),
::view-transition-new(root) {
  animation: none;
  mix-blend-mode: normal;
}

html.theme-wipe-active::view-transition-new(root) {
  animation: focus-theme-wipe 340ms ease-out both;
}

@keyframes focus-theme-wipe {
  from { clip-path: inset(0 100% 0 0); }
  to { clip-path: inset(0 0 0 0); }
}

@media (max-width: 720px) {
  .minimal-screen-header { margin-bottom: 28px; }
  .mission-countdown { justify-items: start; }
}

[data-theme="dark"] .focus-shell .primary-button,
[data-theme="dark"] .onboarding-shell .primary-button,
[data-theme="dark"] .focus-shell .brand-mark,
[data-theme="dark"] .onboarding-shell .brand-mark,
[data-theme="dark"] .focus-shell .upload-icon,
[data-theme="dark"] .theme-toggle button[aria-pressed="true"] {
  color: #0b1220;
}

@media (prefers-reduced-motion: reduce) {
  html.theme-wipe-active::view-transition-new(root) { animation: none !important; }
  .streak-flame-outer,
  .level-cosmetic-aura { animation: none; }
}

/* =========================================================
   STATQUEST — POLISHED LIGHT MODE OVERRIDES
   Appended after the existing stylesheet so Dark/Adventure
   behavior stays intact while Focus/Minimal light mode gains
   a brighter, more cohesive visual system.
   ========================================================= */

html[data-theme="light"] {
  color-scheme: light;
  --background: #f4f7fc;
  --surface: rgba(255, 255, 255, 0.91);
  --surface-soft: rgba(248, 250, 255, 0.84);
  --surface-bright: rgba(239, 243, 252, 0.95);
  --input-surface: rgba(255, 255, 255, 0.88);
  --empty-surface: rgba(248, 250, 255, 0.74);
  --border: rgba(112, 132, 167, 0.24);
  --text: #172033;
  --muted: #5b687d;
  --subtle: #7a8799;
  --primary: #5965e8;
  --primary-hover: #4854d7;
  --green: #1fbd88;
  --success-text: #137653;
  --green-dark: #e7f9f2;
  --orange: #e99a17;
  --reward-text: #cc8100;
  --streak: #ef7d3c;
  --streak-text: #c85b23;
  --info: #35a7ff;
  --danger: #cf405b;
  --blue: #3978d4;
}

/* Background: indigo + sky + mint + a restrained warm accent. */
html[data-theme="light"] body {
  color: var(--text);
  background-color: var(--background);
}

html[data-theme="light"] body::before {
  background:
    radial-gradient(circle at 10% 14%, rgba(89, 101, 232, 0.17), transparent 27%),
    radial-gradient(circle at 88% 12%, rgba(53, 167, 255, 0.13), transparent 25%),
    radial-gradient(circle at 79% 84%, rgba(31, 189, 136, 0.11), transparent 28%),
    radial-gradient(circle at 27% 88%, rgba(245, 165, 36, 0.075), transparent 24%),
    linear-gradient(135deg, #fafbff 0%, #f2f5ff 37%, #f5f9ff 59%, #f3fbf8 78%, #fffaf3 100%);
}

html[data-theme="light"] body::after {
  background-image:
    linear-gradient(rgba(75, 103, 149, 0.06) 1px, transparent 1px),
    linear-gradient(90deg, rgba(75, 103, 149, 0.06) 1px, transparent 1px);
}

html[data-theme="light"] .pointer-grid-glow {
  background-image:
    linear-gradient(rgba(79, 106, 230, 0.34) 1px, transparent 1px),
    linear-gradient(90deg, rgba(43, 188, 154, 0.28) 1px, transparent 1px);
}

/* Register / Welcome Back / Focus entry surfaces. */
html[data-theme="light"] .onboarding-card {
  border-color: rgba(112, 132, 167, 0.23);
  background:
    radial-gradient(circle at 100% 0%, rgba(89, 101, 232, 0.07), transparent 36%),
    radial-gradient(circle at 0% 100%, rgba(31, 189, 136, 0.055), transparent 34%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.94), rgba(248, 250, 255, 0.89));
  box-shadow:
    0 28px 80px rgba(49, 67, 102, 0.12),
    inset 0 1px rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(12px);
}

html[data-theme="light"] .minimal-screen-header {
  border-color: rgba(112, 132, 167, 0.2);
}

/* Top bar and primary Focus panels. */
html[data-theme="light"] .focus-topbar {
  border-color: rgba(94, 113, 164, 0.25);
  background:
    radial-gradient(circle at 6% 0%, rgba(89, 101, 232, .105), transparent 34%),
    radial-gradient(circle at 94% 100%, rgba(31, 189, 136, .075), transparent 32%),
    linear-gradient(105deg, rgba(255, 255, 255, .72), rgba(245, 249, 255, .62));
  box-shadow: 0 11px 32px rgba(48, 67, 102, .11), inset 0 1px rgba(255, 255, 255, .68);
  -webkit-backdrop-filter: blur(14px) saturate(114%);
  backdrop-filter: blur(14px) saturate(114%);
}

html[data-theme="light"] .focus-progress-item,
html[data-theme="light"] .focus-account-menu > summary {
  border-color: rgba(105, 123, 166, .23);
  background: rgba(255, 255, 255, .55);
}

html[data-theme="light"] .focus-account-popover,
html[data-theme="light"] .focus-streak-popover {
  border-color: rgba(105, 123, 166, .25);
  background: rgba(251, 252, 255, .96);
  box-shadow: 0 16px 38px rgba(49, 67, 102, .16);
}

html[data-theme="light"] .level-cosmetic-bronze { border-color: rgba(173, 103, 47, .58); }
html[data-theme="light"] .level-cosmetic-silver { border-color: rgba(105, 139, 184, .56); box-shadow: 0 0 13px rgba(85, 131, 188, .14); }
html[data-theme="light"] .level-cosmetic-gold { border-color: rgba(190, 143, 27, .62); box-shadow: 0 0 15px rgba(206, 158, 36, .18); }
html[data-theme="light"] .level-cosmetic-aura { border-color: rgba(91, 101, 232, .66); box-shadow: 0 0 19px rgba(68, 188, 154, .2); }

html[data-theme="light"] .focus-room {
  color: #172033;
  background:
    radial-gradient(circle at 16% 10%, rgba(89, 101, 232, .17), transparent 31%),
    radial-gradient(circle at 84% 78%, rgba(31, 189, 136, .13), transparent 29%),
    linear-gradient(145deg, #f8f9fe, #eef4ff 55%, #eff9f5);
}
html[data-theme="light"] .focus-room-ambient {
  background-image:
    linear-gradient(rgba(75, 103, 149, .055) 1px, transparent 1px),
    linear-gradient(90deg, rgba(75, 103, 149, .055) 1px, transparent 1px);
}
html[data-theme="light"] .focus-room-minimize {
  color: #25324a;
  border-color: rgba(97, 116, 161, .28);
  background: rgba(255, 255, 255, .68);
}
html[data-theme="light"] .focus-room-primary {
  border-color: rgba(91, 109, 170, .23);
  background: linear-gradient(145deg, rgba(255, 255, 255, .7), rgba(244, 248, 255, .57));
  box-shadow: 0 26px 70px rgba(61, 78, 118, .14), inset 0 1px rgba(255, 255, 255, .72);
}
html[data-theme="light"] .focus-room-primary h1,
html[data-theme="light"] .focus-room-countdown { color: #172033; }
html[data-theme="light"] .focus-room-countdown { text-shadow: 0 12px 38px rgba(79, 95, 210, .14); }
html[data-theme="light"] .focus-room-progress-copy,
html[data-theme="light"] .focus-room-reward-note,
html[data-theme="light"] .focus-room-break-note { color: #59687d; }
html[data-theme="light"] .focus-room-task {
  border-color: rgba(102, 121, 164, .2);
  background: rgba(255, 255, 255, .48);
}
html[data-theme="light"] .focus-room-task span { color: #647287; }
html[data-theme="light"] .focus-room-task strong { color: #26344c; }
html[data-theme="light"] .focus-guardian-dialogue,
html[data-theme="light"] .focus-room-audio {
  border-color: rgba(101, 121, 164, .22);
  background: rgba(255, 255, 255, .56);
  box-shadow: 0 12px 34px rgba(61, 78, 118, .09);
}
html[data-theme="light"] .focus-guardian-dialogue strong,
html[data-theme="light"] .focus-room-audio > div:first-child strong { color: #26344c; }
html[data-theme="light"] .focus-room-audio label { color: #526177; }

html[data-theme="light"] .focus-panel {
  border-color: rgba(112, 132, 167, 0.22);
  background:
    radial-gradient(circle at 100% 0%, rgba(89, 101, 232, 0.035), transparent 30%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.92), rgba(248, 251, 255, 0.87));
  box-shadow:
    0 18px 48px rgba(49, 67, 102, 0.085),
    inset 0 1px rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(9px);
}

/* Brand + headings. */
html[data-theme="light"] .eyebrow { color: #4655d9; }

html[data-theme="light"] h1,
html[data-theme="light"] h2,
html[data-theme="light"] h3,
html[data-theme="light"] h4,
html[data-theme="light"] strong,
html[data-theme="light"] legend { color: var(--text); }

html[data-theme="light"] .brand-mark {
  color: #fff;
  background: linear-gradient(145deg, #6a75ef, #5360df);
  box-shadow:
    0 7px 18px rgba(83, 96, 223, 0.23),
    inset 0 1px rgba(255, 255, 255, 0.28);
}

/* Buttons. */
html[data-theme="light"] .primary-button,
html[data-theme="light"] .focus-add-goal {
  border: 0;
  color: #fff;
  background: linear-gradient(135deg, #5865e8 0%, #6862ec 52%, #5779e5 100%);
  box-shadow:
    0 7px 19px rgba(83, 96, 223, 0.22),
    inset 0 1px rgba(255, 255, 255, 0.22);
  transition: transform 150ms ease, box-shadow 150ms ease, filter 150ms ease;
}

html[data-theme="light"] .primary-button:hover:not(:disabled),
html[data-theme="light"] .focus-add-goal:hover:not(:disabled) {
  filter: brightness(1.035);
  transform: translateY(-1px);
  box-shadow:
    0 10px 25px rgba(83, 96, 223, 0.27),
    inset 0 1px rgba(255, 255, 255, 0.25);
}

html[data-theme="light"] .secondary-button,
html[data-theme="light"] .status-button {
  color: #27334a;
  border-color: rgba(112, 132, 167, 0.25);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.88), rgba(248, 250, 255, 0.81));
}

html[data-theme="light"] .secondary-button:hover:not(:disabled),
html[data-theme="light"] .status-button:hover:not(:disabled) {
  color: #2635ad;
  border-color: rgba(89, 101, 232, 0.4);
  background: #f2f4ff;
}

html[data-theme="light"] .primary-button:disabled,
html[data-theme="light"] .secondary-button:disabled,
html[data-theme="light"] .danger-button:disabled {
  color: #8a95a6;
  border-color: #d6dde8;
  background: #edf0f5;
  box-shadow: none;
}

/* Form controls and labels. */
html[data-theme="light"] label { color: #29364c; }

html[data-theme="light"] input,
html[data-theme="light"] select,
html[data-theme="light"] textarea {
  color: #172033;
  border-color: rgba(112, 132, 167, 0.27);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.95), rgba(250, 251, 255, 0.89));
  box-shadow: inset 0 1px 2px rgba(54, 68, 94, 0.025);
}

html[data-theme="light"] input::placeholder,
html[data-theme="light"] textarea::placeholder { color: #8995a8; }

html[data-theme="light"] input:focus,
html[data-theme="light"] select:focus,
html[data-theme="light"] textarea:focus {
  border-color: #6470e8;
  box-shadow: 0 0 0 3px rgba(89, 101, 232, 0.115);
}

html[data-theme="light"] select option {
  color: #172033;
  background: #fff;
}

html[data-theme="light"] .field-hint,
html[data-theme="light"] .hero-copy,
html[data-theme="light"] .section-copy { color: #647287; }

/* Goal cards and compact neutral surfaces. */
html[data-theme="light"] .compact-goal-item,
html[data-theme="light"] .compact-review-form,
html[data-theme="light"] .compact-latest-review,
html[data-theme="light"] .compact-history,
html[data-theme="light"] .focus-session-controls,
html[data-theme="light"] .evidence-readiness,
html[data-theme="light"] .compact-progress-grid div {
  border-color: rgba(112, 132, 167, 0.21);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(246, 249, 254, 0.82));
}

html[data-theme="light"] .compact-goal-item {
  box-shadow: 0 5px 14px rgba(53, 71, 105, 0.04);
}

html[data-theme="light"] .compact-goal-item small { color: #3978d4; }

/* Mission selector. */
html[data-theme="light"] .mission-selector button {
  color: #27334a;
  border-color: rgba(112, 132, 167, 0.23);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.87), rgba(246, 249, 255, 0.83));
}

html[data-theme="light"] .mission-selector button:hover {
  border-color: rgba(89, 101, 232, 0.55);
  background: linear-gradient(145deg, #f8f8ff, #f0f3ff);
}

html[data-theme="light"] .mission-selector button.selected {
  color: #2635ad;
  border-color: #6671e8;
  background: linear-gradient(135deg, #eef0ff 0%, #f2f5ff 54%, #ecf5ff 100%);
  box-shadow:
    inset 3px 0 #5c68e8,
    0 5px 16px rgba(83, 96, 223, 0.08);
}

html[data-theme="light"] .mission-selector span { color: #68758a; }
html[data-theme="light"] .mission-selector button time,
html[data-theme="light"] .mission-countdown time { color: #cc8100; }

/* Main selected mission card. */
html[data-theme="light"] .compact-mission-card,
html[data-theme="light"] .mission-card {
  color: var(--text);
  border-color: rgba(31, 189, 136, 0.3);
  background:
    radial-gradient(circle at 100% 0%, rgba(31, 189, 136, 0.075), transparent 35%),
    radial-gradient(circle at 0% 0%, rgba(89, 101, 232, 0.07), transparent 33%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.91), rgba(248, 251, 255, 0.87));
  box-shadow: 0 10px 30px rgba(49, 67, 102, 0.06);
}

html[data-theme="light"] .mission-objective { color: #59687d; }

/* Mission steps: no dark slabs in Light mode. */
html[data-theme="light"] .mission-steps > li {
  color: var(--text);
  border-color: rgba(122, 143, 176, 0.22);
  background: linear-gradient(145deg, rgba(249, 251, 255, 0.95), rgba(243, 247, 253, 0.91));
  box-shadow: 0 3px 10px rgba(51, 68, 100, 0.025);
}

html[data-theme="light"] .mission-steps > li:hover {
  border-color: rgba(89, 101, 232, 0.3);
  background: linear-gradient(145deg, #fafbff, #f3f6ff);
}

html[data-theme="light"] .mission-steps h4 { color: #1e2b43; }
html[data-theme="light"] .mission-steps p { color: #5d6c82; }
html[data-theme="light"] .step-title-row span { color: #d48606; }

html[data-theme="light"] .step-check span {
  border-color: #bcc8da;
  background: #fff;
}

html[data-theme="light"] .step-check input:checked + span {
  border-color: #1fbd88;
  background: linear-gradient(145deg, #31ca97, #19b780);
  box-shadow: 0 4px 10px rgba(31, 189, 136, 0.2);
}

html[data-theme="light"] .step-check span::after { color: #fff; }

html[data-theme="light"] .mission-steps > li.step-completed {
  border-color: rgba(31, 189, 136, 0.28);
  background: linear-gradient(145deg, rgba(234, 250, 244, 0.92), rgba(242, 252, 248, 0.9));
}

html[data-theme="light"] .step-completed h4 { color: #4f7267; }
html[data-theme="light"] .step-completed p { color: #71877f; }

/* Evidence = cool blue; completion criteria = mint. */
html[data-theme="light"] .evidence-box {
  border-color: rgba(72, 114, 195, 0.22);
  background:
    radial-gradient(circle at 0 0, rgba(89, 101, 232, 0.07), transparent 52%),
    linear-gradient(145deg, #f3f6ff, #f7f9ff);
}

html[data-theme="light"] .evidence-box h4 { color: #34446a; }
html[data-theme="light"] .evidence-box li { color: #5c6e8b; }
html[data-theme="light"] .evidence-quality-note { color: #5e6f86; }

html[data-theme="light"] .completion-criteria {
  border-color: rgba(31, 189, 136, 0.25);
  background:
    radial-gradient(circle at 100% 0, rgba(31, 189, 136, 0.07), transparent 55%),
    linear-gradient(145deg, #edf9f5, #f3fbf8);
}

html[data-theme="light"] .completion-criteria h4 { color: #177a59; }
html[data-theme="light"] .completion-criteria ul,
html[data-theme="light"] .completion-criteria li { color: #3f6558; }

/* Progress / reward. */
html[data-theme="light"] .compact-progress-grid span,
html[data-theme="light"] .today-reward-status span { color: #69768a; }

html[data-theme="light"] .compact-progress-grid strong { color: #172033; }

html[data-theme="light"] .today-reward-status {
  border-color: rgba(31, 189, 136, 0.31);
  background:
    radial-gradient(circle at 100% 0, rgba(31, 189, 136, 0.11), transparent 60%),
    linear-gradient(135deg, #e9faf4, #f1fcf8);
}

html[data-theme="light"] .today-reward-status span { color: #55766b; }
html[data-theme="light"] .today-reward-status strong { color: #12805c; }

/* Mood: all inactive states stay light. */
html[data-theme="light"] .mood-selector span {
  color: #56647a;
  border-color: rgba(112, 132, 167, 0.24);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.88), rgba(246, 249, 254, 0.84));
}

html[data-theme="light"] .mood-selector label:hover span {
  color: #26334a;
  border-color: rgba(89, 101, 232, 0.4);
  background: #f2f4ff;
}

html[data-theme="light"] .mood-selector label.selected span {
  color: #3340b6;
  border-color: #6671e8;
  background: linear-gradient(135deg, #eaedff, #f1f3ff);
  box-shadow: inset 0 0 0 1px rgba(89, 101, 232, 0.05);
}

/* Review + history text. */
html[data-theme="light"] .latest-review p,
html[data-theme="light"] .latest-review dd { color: #5e6c80; }

html[data-theme="light"] .compact-history .history-list article {
  border-color: rgba(112, 132, 167, 0.19);
  background: linear-gradient(145deg, #fafbfe, #f5f8fc);
}

html[data-theme="light"] .history-list p { color: #69768a; }

html[data-theme="light"] .floating-study-timer {
  color: #1c2941;
  border-color: rgba(87, 105, 190, .4);
  background: linear-gradient(145deg, rgba(255, 255, 255, .86), rgba(241, 246, 255, .78));
  box-shadow: 0 16px 42px rgba(49, 67, 102, .18), inset 0 1px rgba(255, 255, 255, .72);
}
html[data-theme="light"] .floating-study-timer > strong { color: #172033; }
html[data-theme="light"] .floating-study-timer small { color: #59687d; }
html[data-theme="light"] .floating-study-timer time { color: #4655d9; }
html[data-theme="light"] .floating-study-timer.focus time,
html[data-theme="light"] .floating-study-timer.focus .floating-timer-label { color: #137653; }
html[data-theme="light"] .floating-study-timer.break time,
html[data-theme="light"] .floating-study-timer.break .floating-timer-label { color: #216ca5; }

/* Optional study materials: remove remaining dark-only surfaces. */
html[data-theme="light"] .goal-files-disclosure,
html[data-theme="light"] .reference-fieldset {
  border-color: rgba(112, 132, 167, 0.23);
  background: linear-gradient(145deg, rgba(249, 251, 255, 0.87), rgba(244, 248, 253, 0.82));
}

html[data-theme="light"] .upload-dropzone {
  border-color: rgba(89, 101, 232, 0.34);
  color: var(--text);
  background:
    radial-gradient(circle at 50% 0%, rgba(89, 101, 232, 0.08), transparent 62%),
    rgba(249, 251, 255, 0.9);
}

html[data-theme="light"] .upload-dropzone:hover,
html[data-theme="light"] .upload-dropzone:focus-within,
html[data-theme="light"] .upload-dropzone.is-dragging {
  border-color: #5965e8;
  background-color: #f1f4ff;
}

html[data-theme="light"] .upload-icon {
  color: #fff;
  background: linear-gradient(145deg, #6571ed, #5865e8);
}

html[data-theme="light"] .reference-file {
  border-color: rgba(112, 132, 167, 0.22);
  background: rgba(248, 250, 255, 0.86);
}

html[data-theme="light"] .reference-file.ready { border-color: rgba(31, 189, 136, 0.42); }
html[data-theme="light"] .reference-file.ready .file-status { color: #137653; }
html[data-theme="light"] .reference-file.error .file-status { color: #b9364d; }

html[data-theme="light"] .file-progress { background: #dfe5ef; }

html[data-theme="light"] .compact-file-button {
  color: #27334a;
  border-color: rgba(112, 132, 167, 0.28);
  background: rgba(255, 255, 255, 0.84);
}

html[data-theme="light"] .compact-file-button:hover,
html[data-theme="light"] .compact-file-button:focus-within { border-color: #5965e8; }

html[data-theme="light"] .compact-file-button.remove {
  color: #b9364d;
  border-color: rgba(207, 64, 91, 0.34);
  background: rgba(255, 247, 248, 0.88);
}

/* Empty states + pills. */
html[data-theme="light"] .empty-state,
html[data-theme="light"] .focus-empty {
  color: var(--text);
  border-color: rgba(112, 132, 167, 0.27);
  background:
    radial-gradient(circle at 50% 0, rgba(89, 101, 232, 0.045), transparent 70%),
    rgba(248, 250, 254, 0.74);
}

html[data-theme="light"] .focus-count,
html[data-theme="light"] .status-pill,
html[data-theme="light"] .difficulty,
html[data-theme="light"] .pace-pill {
  color: #5e6c81;
  border-color: rgba(112, 132, 167, 0.22);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.86), rgba(244, 247, 253, 0.81));
}

/* Theme toggle. */
html[data-theme="light"] .theme-toggle {
  border-color: rgba(112, 132, 167, 0.21);
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.9), rgba(244, 247, 253, 0.85));
  box-shadow: inset 0 1px rgba(255, 255, 255, 0.6);
}

html[data-theme="light"] .theme-toggle button {
  color: #5b687c;
  background: transparent;
}

html[data-theme="light"] .theme-toggle button:hover { color: #313e57; }

html[data-theme="light"] .theme-toggle button[aria-pressed="true"] {
  color: #fff;
  background: linear-gradient(135deg, #6571ed, #5865e8);
  box-shadow: 0 4px 12px rgba(83, 96, 223, 0.23);
}

html[data-theme="light"] :focus-visible { outline-color: #5965e8; }

@media (prefers-reduced-motion: reduce) {
  html[data-theme="light"] .primary-button,
  html[data-theme="light"] .focus-add-goal {
    transform: none !important;
  }
}


/* =========================================================
   STATQUEST FOCUS — TRANSLUCENT GRADIENT PANELS
   Append-only override for Focus Light Mode
   ========================================================= */

/* Shared glass treatment */
html[data-theme="light"] .focus-dashboard .focus-panel {
  -webkit-backdrop-filter: blur(10px) saturate(115%);
  backdrop-filter: blur(10px) saturate(115%);
  border: 1px solid rgba(105, 124, 164, 0.24);
  box-shadow:
    0 18px 50px rgba(54, 70, 110, 0.09),
    inset 0 1px 0 rgba(255, 255, 255, 0.76);
}

/* Goals — lavender / indigo / cool blue */
html[data-theme="light"] .focus-dashboard .focus-goals-panel {
  background:
    radial-gradient(
      circle at 5% 0%,
      rgba(103, 92, 255, 0.18) 0%,
      rgba(103, 92, 255, 0.07) 28%,
      transparent 52%
    ),
    radial-gradient(
      circle at 100% 100%,
      rgba(82, 145, 255, 0.10) 0%,
      transparent 46%
    ),
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.72) 0%,
      rgba(246, 246, 255, 0.66) 46%,
      rgba(235, 243, 255, 0.60) 100%
    );
}

/* Missions — focal panel, a little more opaque for readability */
html[data-theme="light"] .focus-dashboard .focus-missions-panel {
  background:
    radial-gradient(
      circle at 8% 0%,
      rgba(88, 101, 242, 0.16) 0%,
      rgba(88, 101, 242, 0.055) 28%,
      transparent 50%
    ),
    radial-gradient(
      circle at 100% 12%,
      rgba(54, 165, 255, 0.14) 0%,
      rgba(54, 165, 255, 0.045) 30%,
      transparent 50%
    ),
    radial-gradient(
      circle at 88% 100%,
      rgba(42, 202, 151, 0.09) 0%,
      transparent 42%
    ),
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.80) 0%,
      rgba(245, 248, 255, 0.74) 48%,
      rgba(238, 249, 251, 0.68) 100%
    );
  border-color: rgba(91, 109, 201, 0.26);
  box-shadow:
    0 20px 54px rgba(57, 72, 132, 0.105),
    inset 0 1px 0 rgba(255, 255, 255, 0.82);
}

/* Progress — mint / aqua / subtle warm reward tint */
html[data-theme="light"] .focus-dashboard .focus-progress-panel {
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(37, 204, 151, 0.18) 0%,
      rgba(37, 204, 151, 0.065) 28%,
      transparent 51%
    ),
    radial-gradient(
      circle at 0% 100%,
      rgba(52, 164, 255, 0.10) 0%,
      transparent 44%
    ),
    radial-gradient(
      circle at 100% 82%,
      rgba(245, 165, 36, 0.055) 0%,
      transparent 34%
    ),
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.73) 0%,
      rgba(240, 252, 248, 0.66) 50%,
      rgba(237, 247, 251, 0.61) 100%
    );
  border-color: rgba(62, 159, 137, 0.25);
}

/* Inner cards — calmer and more transparent than the parent panel */
html[data-theme="light"] .focus-dashboard .compact-goal-item,
html[data-theme="light"] .focus-dashboard .compact-progress-grid > div,
html[data-theme="light"] .focus-dashboard .compact-review-form,
html[data-theme="light"] .focus-dashboard .compact-latest-review,
html[data-theme="light"] .focus-dashboard .compact-history {
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.70),
      rgba(248, 250, 255, 0.56)
    );
  border-color: rgba(110, 130, 166, 0.20);
  -webkit-backdrop-filter: blur(6px);
  backdrop-filter: blur(6px);
}

/* Mission selector */
html[data-theme="light"] .focus-dashboard .mission-selector button {
  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.72),
      rgba(243, 247, 255, 0.60)
    );
}

html[data-theme="light"] .focus-dashboard .mission-selector button.selected {
  background:
    radial-gradient(
      circle at 0% 0%,
      rgba(91, 101, 235, 0.15),
      transparent 50%
    ),
    linear-gradient(
      120deg,
      rgba(239, 241, 255, 0.82),
      rgba(237, 248, 255, 0.72)
    );
  border-color: #6470eb;
}

/* Selected mission body */
html[data-theme="light"] .focus-dashboard .compact-mission-card {
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(54, 165, 255, 0.055),
      transparent 37%
    ),
    radial-gradient(
      circle at 100% 100%,
      rgba(42, 202, 151, 0.055),
      transparent 38%
    ),
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.68),
      rgba(246, 250, 255, 0.58)
    );
  -webkit-backdrop-filter: blur(7px);
  backdrop-filter: blur(7px);
}

/* Mission steps */
html[data-theme="light"] .focus-dashboard .mission-steps > li {
  background:
    linear-gradient(
      120deg,
      rgba(255, 255, 255, 0.68),
      rgba(244, 248, 255, 0.54)
    );
  border-color: rgba(110, 130, 166, 0.19);
  -webkit-backdrop-filter: blur(5px);
  backdrop-filter: blur(5px);
}

/* Evidence — soft indigo */
html[data-theme="light"] .focus-dashboard .evidence-box {
  background:
    radial-gradient(
      circle at 0% 0%,
      rgba(89, 101, 232, 0.10),
      transparent 62%
    ),
    linear-gradient(
      135deg,
      rgba(242, 245, 255, 0.67),
      rgba(250, 251, 255, 0.52)
    );
  border-color: rgba(90, 108, 210, 0.22);
}

/* Completion — soft mint */
html[data-theme="light"] .focus-dashboard .completion-criteria {
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(37, 199, 143, 0.12),
      transparent 58%
    ),
    linear-gradient(
      135deg,
      rgba(235, 251, 244, 0.70),
      rgba(247, 253, 250, 0.54)
    );
  border-color: rgba(35, 184, 132, 0.24);
}

/* Today reward */
html[data-theme="light"] .focus-dashboard .today-reward-status {
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(40, 202, 148, 0.14),
      transparent 56%
    ),
    linear-gradient(
      120deg,
      rgba(231, 250, 243, 0.72),
      rgba(243, 253, 249, 0.58)
    );
  border-color: rgba(35, 184, 132, 0.29);
}

/* Minimal entry glass: intentionally scoped away from Focus dashboard and Adventure. */
html[data-theme="light"] .onboarding-shell > .onboarding-card {
  border-color: rgba(91, 109, 201, 0.30);
  background:
    radial-gradient(circle at 5% 0%, rgba(89, 101, 232, 0.045), transparent 42%),
    radial-gradient(circle at 100% 100%, rgba(44, 203, 145, 0.035), transparent 42%),
    linear-gradient(145deg, rgba(255, 255, 255, 0.40), rgba(248, 250, 255, 0.32));
  box-shadow:
    0 24px 70px rgba(49, 67, 102, 0.13),
    inset 0 1px rgba(255, 255, 255, 0.52);
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

html[data-theme="light"] .onboarding-shell > .onboarding-card input,
html[data-theme="light"] .onboarding-shell > .onboarding-card select,
html[data-theme="light"] .onboarding-shell > .onboarding-card textarea {
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.78), rgba(249, 251, 255, 0.70));
}

html[data-theme="dark"] .onboarding-shell > .onboarding-card {
  border-color: rgba(112, 135, 174, 0.32);
  background:
    radial-gradient(circle at 5% 0%, rgba(91, 105, 180, 0.045), transparent 42%),
    linear-gradient(145deg, rgba(7, 11, 19, 0.46), rgba(11, 18, 31, 0.36));
  box-shadow:
    0 26px 76px rgba(0, 0, 0, 0.30),
    inset 0 1px rgba(255, 255, 255, 0.04);
  -webkit-backdrop-filter: none;
  backdrop-filter: none;
}

html[data-theme="dark"] .onboarding-shell > .onboarding-card input,
html[data-theme="dark"] .onboarding-shell > .onboarding-card select,
html[data-theme="dark"] .onboarding-shell > .onboarding-card textarea {
  background: linear-gradient(145deg, rgba(17, 25, 40, 0.80), rgba(10, 17, 29, 0.74));
}

/* Professional Focus entry composition. Adventure remains scoped to its own UI. */
.entry-shell {
  align-items: center;
  padding: clamp(18px, 3vw, 34px);
}

body:has(.entry-return-card)::before {
  animation: entry-welcome-ambient 28s ease-in-out infinite alternate;
}

.entry-card,
.entry-about-dialog {
  font-family: "Segoe UI Variable Text", "Aptos", ui-sans-serif, system-ui, sans-serif;
}

.entry-card {
  position: relative;
  isolation: isolate;
  overflow: clip;
  border-radius: 24px;
  animation: entry-surface-in 320ms cubic-bezier(.22, .76, .28, 1) both;
}

.entry-card h1,
.entry-card h2,
.entry-about-dialog h2,
.entry-brand-copy strong {
  font-family: "Segoe UI Variable Display", "Aptos Display", "Segoe UI", ui-sans-serif, system-ui, sans-serif;
  text-wrap: balance;
}

.entry-card button,
.entry-about-dialog button,
.entry-profile-settings > summary {
  transition:
    color 200ms cubic-bezier(.22, .76, .28, 1),
    border-color 200ms cubic-bezier(.22, .76, .28, 1),
    background-color 200ms cubic-bezier(.22, .76, .28, 1),
    box-shadow 200ms cubic-bezier(.22, .76, .28, 1),
    transform 200ms cubic-bezier(.22, .76, .28, 1);
}

.entry-card button:active,
.entry-about-dialog button:active,
.entry-profile-settings > summary:active { transform: translateY(1px) scale(.985); }

.entry-new-profile {
  width: min(1180px, 100%);
  padding: clamp(24px, 2.7vw, 34px);
}

.entry-return-card {
  width: min(1120px, 100%);
  padding: clamp(24px, 2.6vw, 32px);
}

.entry-return-card .entry-header { margin-bottom: 18px; }

.entry-header {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: center;
  margin-bottom: 24px;
}

.entry-header .brand-mark,
.entry-about-lockup .brand-mark {
  width: 44px;
  height: 44px;
  margin: 0;
  border-radius: 14px;
  color: #07120b;
  background:
    linear-gradient(145deg, rgba(255, 255, 255, .28), transparent 52%),
    var(--green);
  box-shadow:
    0 10px 24px color-mix(in srgb, var(--green) 22%, transparent),
    inset 0 1px rgba(255, 255, 255, .38);
  font-size: 13px;
}

.entry-brand-button {
  display: inline-flex;
  gap: 12px;
  align-items: center;
  padding: 3px 8px 3px 3px;
  border: 0;
  border-radius: 16px;
  color: var(--text);
  background: transparent;
  text-align: left;
}

.entry-brand-copy { display: grid; gap: 1px; }
.entry-brand-copy strong { font-size: 17px; font-weight: 760; letter-spacing: -.035em; }
.entry-brand-copy small { color: var(--muted); font-size: 11px; font-weight: 650; letter-spacing: .025em; }

.entry-brand-button:hover,
.entry-brand-button:focus-visible {
  color: var(--primary-hover);
  background: color-mix(in srgb, var(--surface-soft) 54%, transparent);
  box-shadow: 0 9px 22px color-mix(in srgb, var(--primary) 10%, transparent);
  transform: translateY(-2px);
}

.entry-header .theme-toggle {
  gap: 2px;
  padding: 3px;
  border-radius: 13px;
  background: color-mix(in srgb, var(--surface-soft) 72%, transparent);
}

.entry-header .theme-toggle button { min-height: 44px; padding-inline: 12px; border-radius: 9px; }
.entry-header .theme-toggle button[aria-pressed="true"] { box-shadow: 0 5px 14px color-mix(in srgb, var(--primary) 22%, transparent); }

.entry-profile-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0;
}

.entry-orientation {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(280px, .7fr);
  gap: 14px 42px;
  align-items: end;
  padding: 8px 0 24px;
  border-bottom: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
}

.entry-orientation::after { display: none; }

.entry-orientation .eyebrow,
.entry-return-heading .eyebrow,
.entry-profile-setup-heading > .eyebrow,
.entry-continuity-card > .eyebrow {
  font-size: 11px;
  font-weight: 820;
  letter-spacing: .16em;
}

.entry-orientation > .eyebrow,
.entry-profile-setup-heading > .eyebrow,
.entry-return-heading .eyebrow { display: none; }

.entry-orientation h1 {
  max-width: 720px;
  margin: 0;
  font-size: clamp(46px, 5.2vw, 68px);
  font-weight: 760;
  line-height: .96;
  letter-spacing: -.04em;
}

.entry-orientation .hero-copy {
  max-width: 44ch;
  margin: 0 0 4px;
  font-size: 15px;
  line-height: 1.6;
  text-wrap: pretty;
}

.entry-promise-mobile { display: none; }

.entry-product-cycle,
.entry-about-flow {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  margin: 24px 0 0;
  padding: 0;
  list-style: none;
}

.entry-orientation > .entry-product-cycle,
.entry-orientation > .entry-trust-note { grid-column: 1 / -1; }

.entry-orientation > .entry-product-cycle {
  padding-top: 16px;
  border-top: 1px solid color-mix(in srgb, var(--primary) 20%, var(--border));
}

.entry-product-cycle li,
.entry-about-flow li {
  position: relative;
  display: grid;
  gap: 7px;
  justify-items: start;
  min-width: 0;
}

.entry-product-cycle li:not(:last-child)::after,
.entry-about-flow li:not(:last-child)::after {
  position: absolute;
  z-index: -1;
  top: 14px;
  right: 8px;
  left: 33px;
  height: 1px;
  background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 54%, var(--border)), color-mix(in srgb, var(--border) 75%, transparent));
  content: "";
}

.entry-product-cycle li > span,
.entry-about-flow li > span {
  display: grid;
  width: 29px;
  height: 29px;
  place-items: center;
  border: 1px solid color-mix(in srgb, var(--primary) 42%, var(--border));
  border-radius: 50%;
  color: var(--primary-hover);
  background: color-mix(in srgb, var(--surface-bright) 68%, transparent);
  font-size: 10px;
  font-variant-numeric: tabular-nums;
  font-weight: 800;
  letter-spacing: .03em;
}

.entry-product-cycle li > strong,
.entry-about-flow li > strong {
  overflow: hidden;
  max-width: 100%;
  font-size: 11px;
  font-weight: 720;
  letter-spacing: -.01em;
  text-overflow: ellipsis;
}

.entry-product-cycle li {
  transition:
    transform 220ms cubic-bezier(.16, 1, .3, 1);
}

.entry-product-cycle li > span,
.entry-product-cycle li > strong,
.entry-product-cycle li::after {
  transition:
    color 220ms cubic-bezier(.16, 1, .3, 1),
    border-color 220ms cubic-bezier(.16, 1, .3, 1),
    background-color 220ms cubic-bezier(.16, 1, .3, 1),
    box-shadow 220ms cubic-bezier(.16, 1, .3, 1),
    opacity 220ms cubic-bezier(.16, 1, .3, 1);
}

.entry-product-cycle li > strong { color: var(--muted); }
.entry-product-cycle li.is-system-preview > strong { color: var(--text); }

.entry-product-cycle li:not(.is-system-preview) > span {
  border-color: color-mix(in srgb, var(--border) 82%, var(--primary));
  color: var(--muted);
  background: color-mix(in srgb, var(--surface-bright) 72%, transparent);
}

.entry-product-cycle li:not(.is-system-preview):not(:last-child)::after {
  background: color-mix(in srgb, var(--border) 74%, transparent);
}

.entry-product-cycle li.is-system-preview > span {
  border-color: color-mix(in srgb, var(--primary) 48%, var(--border));
  color: var(--primary-hover);
  background: color-mix(in srgb, var(--primary) 7%, var(--surface-bright));
}

.entry-product-cycle li.is-system-preview:not(:last-child)::after {
  background: linear-gradient(90deg, color-mix(in srgb, var(--primary) 56%, var(--border)), color-mix(in srgb, var(--primary) 30%, var(--border)));
}

.entry-product-cycle li.is-next-focus { transform: translateY(-1px); }
.entry-product-cycle li.is-next-focus > span {
  border-color: var(--primary);
  color: var(--primary-hover);
  background: color-mix(in srgb, var(--primary) 11%, var(--surface-bright));
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--primary) 9%, transparent);
  animation: entry-path-orient 360ms cubic-bezier(.16, 1, .3, 1) both;
}

.entry-trust-note {
  display: flex;
  gap: 9px;
  align-items: center;
  margin: 14px 0 0;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.45;
}

.entry-trust-note::before {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 0 4px color-mix(in srgb, var(--green) 12%, transparent);
  content: "";
}

.entry-trust-note strong { font-size: 12px; font-weight: 720; }

.entry-mobile-how-it-works { display: none; }

.entry-profile-setup {
  display: grid;
  grid-template-columns: minmax(200px, .28fr) minmax(0, 1fr);
  gap: 24px 34px;
  margin-top: 24px;
  padding: 24px;
  border: 0;
  border-radius: 14px;
  background: color-mix(in srgb, var(--surface-soft) 58%, transparent);
  box-shadow: none;
}

.entry-profile-setup-heading {
  position: relative;
  align-self: start;
  padding-top: 2px;
}

.entry-profile-setup-heading h2 {
  margin: 0 0 8px;
  padding-right: 50px;
  font-size: clamp(28px, 2.5vw, 34px);
  font-weight: 740;
  line-height: 1.04;
  letter-spacing: -.035em;
}

.entry-profile-setup-heading > p:not(.eyebrow) { max-width: 31ch; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.55; text-wrap: pretty; }

.entry-profile-guide.quest-character {
  --companion-size: 46px;
  position: absolute;
  top: 0;
  right: 0;
  filter: drop-shadow(0 8px 7px color-mix(in srgb, var(--green) 12%, rgba(12, 23, 37, .18)));
  transform-origin: center bottom;
  animation: entry-guardian-idle 6.8s ease-in-out infinite;
}

.entry-profile-guide .companion-image { animation: entry-guardian-blink 7.6s ease-in-out infinite; }
.entry-profile-guide.quest-character.concerned { animation: entry-guide-concerned 300ms cubic-bezier(.16, 1, .3, 1); }
.entry-profile-guide.quest-character.happy { animation: entry-guide-ready 480ms cubic-bezier(.16, 1, .3, 1); }

.entry-profile-setup form {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: 14px 12px;
  margin-top: 0;
}
.entry-profile-setup form > label:first-child { grid-column: span 4; }
.entry-profile-setup form > .profile-fields { display: contents; }
.entry-profile-setup form > .profile-fields > label { grid-column: span 4; }
.entry-profile-setup form > label:nth-of-type(2) { grid-column: span 8; }
.entry-profile-setup form label { gap: 7px; color: var(--text); font-size: 13px; font-weight: 680; }
.entry-profile-setup form input,
.entry-profile-setup form select {
  min-height: 44px;
  padding: 10px 12px;
  border-radius: 11px;
  font-size: 13px;
  box-shadow: inset 0 1px color-mix(in srgb, white 38%, transparent);
}

.entry-profile-setup form input:hover,
.entry-profile-setup form select:hover { border-color: color-mix(in srgb, var(--primary) 52%, var(--border)); }

.entry-profile-setup form input:focus,
.entry-profile-setup form select:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 15%, transparent), inset 0 1px color-mix(in srgb, white 38%, transparent);
}

.entry-profile-setup form input[aria-invalid="true"],
.entry-profile-setup form select[aria-invalid="true"] {
  border-color: var(--danger);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--danger) 11%, transparent);
}

.entry-profile-setup .field-error {
  color: var(--danger);
  font-size: 11px;
  font-weight: 650;
  line-height: 1.4;
}

.entry-profile-actions {
  display: grid;
  grid-column: span 4;
  grid-template-columns: minmax(0, 1fr);
  gap: 10px;
  align-self: end;
  margin-top: 0;
}

.entry-profile-actions button { min-height: 48px; font-size: 13px; }
.entry-focus-action { box-shadow: 0 11px 26px color-mix(in srgb, var(--primary) 24%, transparent); }
.entry-focus-action:hover { box-shadow: 0 14px 32px color-mix(in srgb, var(--primary) 29%, transparent); transform: translateY(-1px); }
.entry-focus-action.is-ready { animation: entry-focus-ready 460ms cubic-bezier(.16, 1, .3, 1) both; }

.entry-adventure-choice {
  display: grid;
  gap: 5px;
  max-width: none;
}

.entry-adventure-choice small,
.entry-adventure-return small {
  color: var(--muted);
  font-size: 10px;
  font-weight: 620;
  line-height: 1.35;
  text-wrap: pretty;
}

.entry-adventure-action {
  min-height: 44px;
  border-color: transparent;
  color: var(--muted);
  background: transparent;
  font-weight: 720;
}

.entry-profile-setup .saved-profile-list {
  grid-column: 1 / -1;
  grid-template-columns: minmax(180px, .28fr) minmax(0, 1fr) minmax(0, 1fr);
  gap: 12px;
  align-items: center;
  margin-top: 0;
  padding-top: 18px;
}

.entry-profile-setup .saved-profile-list > span { grid-column: auto; font-size: 11px; letter-spacing: .08em; }
.entry-saved-profile-button { min-height: 44px; padding: 9px 10px; color: var(--muted); font-size: 12px; background: color-mix(in srgb, var(--surface-soft) 46%, transparent); }
.entry-saved-profile-button:hover { color: var(--text); border-color: color-mix(in srgb, var(--primary) 42%, var(--border)); }

.entry-saved-profile-disclosure {
  position: relative;
}

.entry-saved-profile-disclosure > summary,
.entry-profile-switcher > summary {
  display: grid;
  min-height: 44px;
  place-items: center;
  padding: 9px 28px 9px 10px;
  border: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
  border-radius: 10px;
  color: var(--muted);
  background: transparent;
  font-size: 12px;
  font-weight: 720;
  list-style: none;
  cursor: pointer;
}

.entry-saved-profile-disclosure > summary::-webkit-details-marker,
.entry-profile-switcher > summary::-webkit-details-marker { display: none; }

.entry-saved-profile-disclosure > summary::after,
.entry-profile-switcher > summary::after {
  position: absolute;
  right: 11px;
  width: 7px;
  height: 7px;
  border-right: 2px solid currentColor;
  border-bottom: 2px solid currentColor;
  content: "";
  transform: translateY(-2px) rotate(45deg);
}

.entry-saved-profile-disclosure[open] > summary::after,
.entry-profile-switcher[open] > summary::after { transform: translateY(2px) rotate(225deg); }

.entry-saved-profile-disclosure > div,
.entry-profile-switcher > div {
  display: grid;
  gap: 7px;
  margin-top: 7px;
}

.entry-saved-profile-disclosure[open] { grid-column: 1 / -1; }
.entry-saved-profile-disclosure[open] > div { grid-template-columns: repeat(2, minmax(0, 1fr)); }

.entry-return-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 34px;
  align-items: center;
}

.entry-return-heading h1 {
  max-width: 760px;
  margin: 0 0 5px;
  overflow-wrap: anywhere;
  font-size: clamp(30px, 3.2vw, 38px);
  font-weight: 760;
  line-height: 1.04;
  letter-spacing: -.03em;
}

.entry-return-heading .hero-copy { margin: 0; color: var(--muted); font-size: 13px; line-height: 1.5; }

.entry-compact-stats {
  display: flex;
  align-items: center;
  min-height: 40px;
  padding-block: 6px;
  border-block: 1px solid color-mix(in srgb, var(--border) 64%, transparent);
  font-variant-numeric: tabular-nums;
}

.entry-compact-stats div {
  display: flex;
  gap: 8px;
  align-items: baseline;
  min-width: 0;
  padding: 0 16px;
  border-left: 1px solid color-mix(in srgb, var(--border) 82%, transparent);
}

.entry-compact-stats div:first-child { padding-left: 0; border-left: 0; }
.entry-compact-stats div:last-child { padding-right: 0; }
.entry-compact-stats span { color: var(--muted); font-size: 11px; font-weight: 780; letter-spacing: .06em; text-transform: uppercase; }
.entry-compact-stats strong { font-size: 16px; font-weight: 750; letter-spacing: -.02em; white-space: nowrap; }

.entry-return-grid {
  display: block;
