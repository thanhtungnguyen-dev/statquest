    id,
    previewMode: 'svelte-component',
    contractVersion: 2,
    sourceFile: sourceFile.split(path.sep).join('/'),
    sourceStartLine,
    sourceEndLine,
    count,
    propContract: contract,
    originalMarkup,
    seededSelectors,
