.entry-today-plan p + p { border-top: 1px solid color-mix(in srgb, var(--border) 50%, transparent); }
.entry-today-plan span { color: var(--muted); font-size: 11px; font-weight: 760; letter-spacing: .06em; text-transform: uppercase; }
.entry-today-plan strong { font-size: 13px; font-variant-numeric: tabular-nums; font-weight: 700; text-align: right; }

.entry-return-utility-row { display: flex; gap: 24px; justify-content: space-between; align-items: center; margin-top: 10px; padding-inline: 2px; }
.entry-secondary-actions { display: flex; gap: 8px; align-items: center; margin-top: 0; }
.entry-adventure-return {
