    if (scopedHtmlFindings.length > 0) {
      const mapped = scopedHtmlFindings.map(f => {
        const item = { type: f.id, detail: f.snippet };
        if (f.severity) {
          item.severity = f.severity;
        } else if (f.id === 'pulsing-dot' && f.selector) {
