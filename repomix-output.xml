.entry-step-progress span { height: 7px; border-radius: 999px; background: color-mix(in srgb, var(--border) 72%, transparent); }
.entry-step-progress .is-complete { background: var(--green); }
.entry-step-progress .is-current { background: var(--primary); box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary) 12%, transparent); }

.entry-recommendation-reasons { display: grid; gap: 7px; margin-top: 2px; }
.entry-recommendation-reasons ul { display: grid; gap: 5px; margin: 0; padding: 0; list-style: none; }
.entry-recommendation-reasons li { position: relative; padding-left: 15px; color: var(--muted); font-size: 13px; line-height: 1.4; }
.entry-recommendation-reasons li::before { position: absolute; top: .55em; left: 0; width: 5px; height: 5px; border-radius: 50%; background: var(--green); content: ""; }

.entry-time-estimate { font-variant-numeric: tabular-nums; font-weight: 650; }
.entry-primary-action { width: fit-content; min-width: 190px; min-height: 48px; margin-top: 5px; box-shadow: 0 12px 28px color-mix(in srgb, var(--primary) 24%, transparent); }
