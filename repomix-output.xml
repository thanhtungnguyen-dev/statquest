}
.quest-character.small { width: 105px; }
.quest-character.mini { width: 62px; filter: drop-shadow(0 4px 3px rgba(35, 57, 44, 0.14)); }
.hero-shadow { fill: rgba(38, 68, 52, .2); }
.hero-body, .hero-head, .hero-ear.filled, .hero-tail { fill: var(--hero-main); stroke: var(--hero-shade); stroke-width: 6; stroke-linejoin: round; }
.hero-belly, .fox-muzzle { fill: #fff0d6; stroke: var(--hero-shade); stroke-width: 4; }
.hero-foot { fill: var(--hero-shade); stroke: var(--hero-shade); stroke-width: 5; }
.hero-ear:not(.filled) { fill: none; stroke: var(--hero-shade); stroke-width: 8; stroke-linecap: round; stroke-linejoin: round; }
.hero-inner-ear { fill: #f8a6a1; stroke: none; }
.owl-face { fill: #fff6dd; stroke: var(--hero-shade); stroke-width: 3; }
.hero-tail-tip { fill: #fff0d6; stroke: none; }
.hero-eye { fill: #fffdf3; transform-origin: center; animation: hero-blink 5.4s ease-in-out infinite; }
.hero-pupil { fill: #193446; transform: translate(var(--look-x), var(--look-y)); transition: transform 110ms ease-out; }
.eye-spark { fill: #fff; transform: translate(var(--look-x), var(--look-y)); }
.hero-brow { fill: none; stroke: #254052; stroke-width: 4; stroke-linecap: round; transition: transform 160ms ease; }
.hero-brow.left { transform-origin: 72px 51px; }
.hero-brow.right { transform-origin: 110px 51px; }
.hero-beak { fill: #f3b642; stroke: #865c21; stroke-width: 3; }
.hero-mouth { fill: none; stroke: #713845; stroke-width: 4; stroke-linecap: round; }
.hero-cheek { fill: #f39aaa; opacity: .6; }
.hero-glasses { fill: none; stroke: #2f4654; stroke-width: 4; }
.hero-satchel path { fill: none; stroke: #6f4931; stroke-width: 8; stroke-linecap: round; }
.hero-satchel rect { fill: #b87943; stroke: #6f4931; stroke-width: 5; }
.hero-leaf { fill: #76c94e; stroke: #367a3c; stroke-width: 4; }
.hero-head-group { transform: translate(calc(var(--look-x) * .45), calc(var(--look-y) * .25)); transform-origin: center 90px; transition: transform 150ms ease-out; }
.hero-tail { transform-origin: 130px 172px; animation: tail-wag 2.8s ease-in-out infinite alternate; }
.celebration-stars { fill: #ffd94f; opacity: 0; transform-origin: center; }
.quest-character.happy .hero-mouth { d: path("M79 89q12 16 24 0"); }
.quest-character.concerned .hero-brow.left { transform: rotate(15deg); }
.quest-character.concerned .hero-brow.right { transform: rotate(-15deg); }
.quest-character.concerned .hero-mouth { d: path("M80 101q11-10 22 0"); }
.quest-character.concerned { animation-name: hero-concerned; }
.quest-character.celebrating { animation: hero-celebrate .72s ease-in-out infinite alternate; }
.quest-character.celebrating .celebration-stars { opacity: 1; animation: star-spin 1.5s linear infinite; }

.level-card {
