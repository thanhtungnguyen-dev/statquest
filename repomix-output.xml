.entry-profile-settings > div { display: grid; gap: 7px; margin-top: 8px; padding: 10px; border: 1px solid var(--border); border-radius: 12px; background: var(--surface); box-shadow: 0 14px 32px color-mix(in srgb, var(--primary) 10%, transparent); }
.entry-profile-settings button { width: 100%; min-height: 44px; padding: 8px 9px; font-size: 12px; }
.entry-profile-switcher { position: relative; }
