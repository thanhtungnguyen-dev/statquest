/* Enter-world transition */
.enter-world-transition { display: grid; min-height: 100svh; place-items: center; }
.enter-world-transition .game-world-backdrop { z-index: 0; }
.transition-message {
  position: relative;
  z-index: 4;
  width: min(620px, calc(100% - 36px));
  margin-top: -22vh;
  padding: 28px;
  border: 2px solid rgba(62, 87, 66, .25);
  border-radius: 28px;
  color: #24485a;
  background: rgba(255, 253, 240, .95);
  box-shadow: 0 22px 60px rgba(47, 83, 61, .27);
  text-align: center;
}
.transition-message p { margin-bottom: 8px; color: #1c6846; font-size: 12px; font-weight: 950; letter-spacing: .13em; }
.transition-message h1 { margin-right: auto; margin-left: auto; font-size: clamp(35px, 5vw, 56px); }
.transition-message span { color: #4a6570; font-weight: 700; }
.transition-hero { position: absolute; z-index: 5; bottom: 8%; left: 13%; animation: enter-path 2.1s cubic-bezier(.22,.77,.3,1) forwards; }
.transition-hero .quest-character { width: clamp(120px, 14vw, 180px); }
.portal-ring {
  position: absolute;
  z-index: 3;
  right: 14%;
  bottom: 26%;
  width: 150px;
  height: 190px;
  border: 9px solid rgba(255, 242, 133, .85);
  border-radius: 50%;
  box-shadow: 0 0 22px #fff0a2, inset 0 0 24px #fff5b2;
  animation: portal-pulse 1s ease-in-out infinite alternate;
}
.portal-ring span { position: absolute; width: 9px; height: 9px; border-radius: 50%; background: #fff8c5; box-shadow: 0 0 8px #fff; animation: star-spin 1.3s linear infinite; }
.portal-ring span:nth-child(1) { top: 12%; left: -9px; }
.portal-ring span:nth-child(2) { top: 49%; right: -11px; animation-delay: -.4s; }
.portal-ring span:nth-child(3) { bottom: 6%; left: 18px; animation-delay: -.8s; }
.skip-transition { position: fixed; z-index: 7; right: 22px; bottom: 20px; border: 2px solid #315d5e; color: #25484f; background: rgba(255, 253, 240, .94); }
.skip-transition:hover { background: #e4f2dc; }

@keyframes sun-breathe { to { transform: scale(1.06); box-shadow: 0 0 0 25px rgba(255, 238, 157, .14), 0 0 90px #fff0a3; } }
@keyframes cloud-drift { from { margin-left: -10%; } to { margin-left: 120%; } }
@keyframes smoke-rise { 50% { transform: translate(12px, -16px) scale(1.08); opacity: .55; } }
@keyframes bird-travel { 0% { transform: translateX(-18vw); } 50% { transform: translateX(28vw) translateY(-20px); } 100% { transform: translateX(62vw); } }
@keyframes butterfly-float { 50% { margin-top: -24px; margin-left: 18px; } }
@keyframes wing-left { to { transform: rotateY(65deg); } }
@keyframes wing-right { to { transform: rotateY(-65deg); } }
@keyframes falling-leaf { 0% { transform: translate(-30px,-80px) rotate(0); opacity: 0; } 15% { opacity: .9; } 100% { transform: translate(130px,380px) rotate(540deg); opacity: 0; } }
@keyframes particle-rise { 0%,100% { transform: translateY(0) scale(.65); opacity: .2; } 50% { transform: translateY(-28px) scale(1.1); opacity: 1; } }
@keyframes grass-idle { to { margin-left: 2px; } }
@keyframes flower-sway { to { margin-left: 3px; } }
@keyframes hero-idle { 0%,100% { transform: translateY(0) rotate(-1deg); } 50% { transform: translateY(-5px) rotate(1deg); } }
@keyframes hero-blink { 0%,44%,48%,100% { transform: scaleY(1); } 46% { transform: scaleY(.08); } }
@keyframes tail-wag { to { transform: rotate(10deg); } }
@keyframes hero-concerned { 0%,100% { transform: rotate(-1deg); } 50% { transform: rotate(1deg) translateY(2px); } }
@keyframes hero-celebrate { to { transform: translateY(-13px) rotate(3deg) scale(1.03); } }
@keyframes star-spin { to { transform: rotate(360deg); } }
@keyframes portal-pulse { to { transform: scale(1.05); filter: brightness(1.12); } }
@keyframes enter-path {
  0% { left: 10%; bottom: 7%; transform: scale(1) rotate(-4deg); opacity: 1; }
  42% { left: 45%; bottom: 15%; transform: scale(.82) rotate(4deg); opacity: 1; }
  82% { left: 75%; bottom: 23%; transform: scale(.5) rotate(-3deg); opacity: 1; }
  100% { left: 82%; bottom: 31%; transform: scale(.2); opacity: 0; }
}

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  body::before { animation: none; }
  .pointer-grid-glow { display: none; }
  *, *::before, *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
  .world-landscape,
  .hero-head-group,
  .hero-pupil,
  .grass-blade,
  .meadow-flower { transition: none !important; }
  .enter-world-transition.reduced .transition-hero {
    left: 48%;
    bottom: 8%;
    opacity: 1;
    animation: none !important;
  }
  .enter-world-transition.reduced .portal-ring { animation: none !important; }
}

